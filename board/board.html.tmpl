}

// Interactive lessons use authored, verified states; no eval or arbitrary code execution.
function renderInteractive(kind,raw){
  try{
    const spec=JSON.parse(raw);
    if(!['trace','function'].includes(kind))throw Error('Unknown interactive type');
    if(kind==='trace'&&(!Array.isArray(spec.code)||!spec.code.every(x=>typeof x==='string')||!Array.isArray(spec.steps)||!spec.steps.length||!spec.steps.every(x=>x&&Number.isInteger(x.line)&&x.line>=0&&x.line<=spec.code.length&&(!x.variables||(typeof x.variables==='object'&&!Array.isArray(x.variables))))))throw Error('Trace requires source lines and valid execution steps');
    if(kind==='function'&&(!Array.isArray(spec.coefficients)||!spec.coefficients.length))throw Error('Function requires polynomial coefficients');
    return `<div class="interactive" data-kind="${kind}" data-spec="${esc(JSON.stringify(spec))}"><h4>${esc(spec.title||'Explore')}</h4><div class="interactive-stage"></div></div>`;
  }catch(e){return `<p class="fail">Interactive block: ${esc(e.message)}</p>`;}
}
function wireInteractive(el){
