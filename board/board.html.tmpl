    let p=k+key.length, d=1; while(p<t.length&&d){ if(t[p]==='{')d++; else if(t[p]==='}')d--; p++; } const cls=t.slice(k+key.length,p-1);
    if(t[p]!=='{'){out+=t.slice(i,p);i=p;continue}
    let q=p+1; d=1; while(q<t.length&&d){ if(t[q]==='\\'){q+=2;continue} if(t[q]==='{')d++; else if(t[q]==='}')d--; q++; }
    out+=t.slice(i,k)+'\\\\ &\\htmlClass{'+cls+' stacked}{'+t.slice(p+1,q-1)+'}'; i=q; }
  return out; }
