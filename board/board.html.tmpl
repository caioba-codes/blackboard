  want.forEach((t,j)=>{ if(pair[j]){prev=pair[j];return;} const el=bsLine(t); if(prev)prev.after(el); else box.prepend(el); prev=el; animate(el); });
  if(!want.length&&!cur.length) box.remove();
}
function bsWipeAll(){
  const box=document.getElementById('brainstorm'); if(!box||!box.isConnected)return;
  box.dataset.rev=1e15; // ignore further notes for this lesson
  box.querySelectorAll(':scope>.bl:not(.smudge)').forEach(el=>{ if(!el.dataset.gone) eraseLine(el,box); });
  setTimeout(()=>box.remove(),Math.max(0,pen.free-performance.now())+400);
}
function setWriting(on){
  document.getElementById('writing')?.remove();
  if(!on||MODE!=='lesson'){ nub.classList.remove('idle'); return; }
  if(!bodyStarted()){
    // nothing written yet: never an empty board or a loading bar; write the title as the first brainstorm note
    if(!document.getElementById('brainstorm')?.isConnected&&fmCache&&fmCache.title) applyBrainstorm({lesson:lessonId,lines:['Explain: '+fmCache.title],rev:1});
    return;
  }
  // between blocks: the chalk stick rests where the writing stopped, until the next block starts
  if(pen.free<=performance.now()){ const last=[...main.querySelectorAll(':scope>.blk')].pop(); if(last){ const r=last.getBoundingClientRect(); if(r.bottom>0&&r.bottom<innerHeight+40){ nub.style.left=(r.left+8)+'px'; nub.style.top=(r.bottom+6)+'px'; nub.classList.add('on','idle'); } } }
}
function followIfAtBottom(el){
  const gap=document.documentElement.scrollHeight-window.innerHeight-window.scrollY;
