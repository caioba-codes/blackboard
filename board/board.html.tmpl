function selBand(l,t,r,b){ const d=document.createElement('div'); d.className='selband'; Object.assign(d.style,{left:(l+window.scrollX-1)+'px',top:(t+window.scrollY-1)+'px',width:(r-l+2)+'px',height:(b-t+2)+'px'}); selBands.appendChild(d); }
