// One lesson, one highlight colour. The board stays chalk on black; the accent
// is the only colour in the lesson layer. `accent:` in the front matter picks
// it by name or hex, otherwise it cycles by lesson number so neighbouring
// lessons never look alike. `accent2:` adds an optional second colour.
const ACCENTS={red:'#9b3a4a',blue:'#3f6f9b',green:'#4a8b5f',amber:'#a8762f',violet:'#7a5a9b',teal:'#3d8080'};
const ACCENT_ORDER=['red','blue','green','amber','violet','teal'];
function resolveAccent(v,fallback){
  if(!v) return fallback;
  const k=String(v).trim().toLowerCase();
  if(ACCENTS[k]) return ACCENTS[k];
