  if(el.classList.contains('stacked')){ el.classList.remove('stacked'); el.innerHTML=ktx(marginNotes(decodeURIComponent(el.dataset.tex)),true); }
  el.style.fontSize='';
  if(fits()) return;
  // shrink to the floor first: stacking the reasons under their steps is the last resort, never the first
  for(const f of [.95,.9,.86,.83,.8]){ el.style.fontSize=f+'em'; if(fits()) return; }
  const tex=marginNotes(decodeURIComponent(el.dataset.tex));
  if(!/mnote/.test(tex)) return;
  el.style.fontSize=''; el.classList.add('stacked');
