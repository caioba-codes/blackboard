function sfx(name){
  const seq=SFX[name]; if(!seq||FX.muted)return;
  const now=performance.now(); if(now-(sfxLast[name]||0)<600)return; sfxLast[name]=now;
  try{ FX.audio=FX.audio||new (window.AudioContext||window.webkitAudioContext)(); const ac=FX.audio; if(ac.state==='suspended')ac.resume();
    let t=ac.currentTime+.01;
