    const stop=()=>{clearInterval(timer);timer=null;stage.querySelector('[data-action=play]').textContent='Play';};
    const draw=()=>{const step=spec.steps[index];stage.querySelector('.trace-code').innerHTML=spec.code.map((line,i)=>`<span class="trace-line${i+1===step.line?' active':''}">${esc(line)}</span>`).join('');stage.querySelector('.trace-vars').textContent=Object.entries(step.variables||{}).map(([k,v])=>k+' = '+(typeof v==='string'?v:JSON.stringify(v))).join('\n')||'—';stage.querySelector('.trace-output').textContent=String(step.output??'');stage.querySelector('.trace-note').textContent=step.note||'';stage.querySelector('.trace-count').textContent=(index+1)+' / '+spec.steps.length;stage.querySelector('[data-action=back]').disabled=index===0;stage.querySelector('[data-action=next]').disabled=index===spec.steps.length-1;};
    stage.querySelector('[data-action=next]').onclick=()=>{stop();index=Math.min(index+1,spec.steps.length-1);draw();};
    stage.querySelector('[data-action=back]').onclick=()=>{stop();index=Math.max(0,index-1);draw();};
    stage.querySelector('[data-action=reset]').onclick=()=>{stop();index=0;draw();};
    stage.querySelector('[data-action=play]').onclick=()=>{if(timer){stop();return;}if(index===spec.steps.length-1)index=0;draw();stage.querySelector('[data-action=play]').textContent='Pause';timer=setInterval(()=>{if(!el.isConnected||document.hidden){stop();return;}index=Math.min(index+1,spec.steps.length-1);draw();if(index===spec.steps.length-1)stop();},1100);};
    draw();
  }else{
    const p=spec.parameter||{},coeff=spec.coefficients.map(Number),at=Number.isInteger(p.index)?p.index:0;
    if(at<0||at>=coeff.length||!coeff.every(Number.isFinite)){stage.textContent='Invalid polynomial parameters.';return;}
    const min=Number(p.min??-3),max=Number(p.max??3),step=Number(p.step??0.1);
    if(!Number.isFinite(min)||!Number.isFinite(max)||min>=max||!Number.isFinite(step)||step<=0){stage.textContent='Invalid slider range.';return;}
    stage.innerHTML=`<label>${esc(p.label||'Parameter')} <output></output><br><input type="range" min="${min}" max="${max}" step="${step}" value="${Math.max(min,Math.min(max,coeff[at]))}"></label><svg viewBox="0 0 640 340" role="img" aria-label="${esc(spec.title||'Function graph')}"><path class="axis" d="M20 170H620 M320 20V320"/><text x="603" y="190" fill="currentColor">x</text><text x="330" y="30" fill="currentColor">y</text><path class="curve"/></svg><p class="function-note"></p>`;
    const input=stage.querySelector('input'),draw=()=>{coeff[at]=Number(input.value);stage.querySelector('output').textContent=input.value;let d='';for(let i=0;i<=600;i++){const x=(i-300)/60,y=coeff.reduceRight((sum,c)=>sum*x+c,0),py=Math.max(-10000,Math.min(10000,170-y*30));d+=(i?'L':'M')+(i+20)+','+py.toFixed(2);}stage.querySelector('.curve').setAttribute('d',d);stage.querySelector('.function-note').textContent=(spec.prompt||'Move the slider and observe the curve.')+' Graph window: x −5 to 5, y −5 to 5.';};input.oninput=draw;draw();
