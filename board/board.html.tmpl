    catch(_){ body.innerHTML='<p class="svmiss">Not found on this Mac.</p>'; } }
  document.documentElement.classList.add('srcopen'); v.setAttribute('aria-hidden','false');
  v.querySelector('.svback').focus({preventScroll:true});
  $('#chatq').placeholder=`Ask about ${f.name}${srcPage(f)}`;
  $('#chatctx').textContent=`Viewing ${f.path||f.name}${srcPage(f)}`;
}
function srcClose(){
  if(!srcv.open)return;
  srcv.open=null;
  const v=$('#srcview'); v.querySelector('.svbody').innerHTML=''; v.setAttribute('aria-hidden','true');
  document.documentElement.classList.remove('srcopen');
  window.scrollTo(0,srcv.y);
  $('#chatq').placeholder='Ask about this lesson';
  $('#chatctx').textContent=`Lesson ${lessonId}`+(chatTitle()?` · ${chatTitle()}`:'');
}
function srcViewing(){ const f=srcv.open; return f?`${f.path||f.name}${srcPage(f)}`:''; }
$('#srcview .svback').onclick=srcClose;
document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&srcv.open&&!e.defaultPrevented){ e.preventDefault(); srcClose(); } });
function srcLink(f,label){ return f.found?`<a class="srclink" href="${esc(f.url)}" data-src="${esc(JSON.stringify(f))}" title="Open ${esc(f.path)}${f.page?' at page '+f.page:''}">${esc(label||f.name)}</a>`:`<span class="sfmiss" title="not found on this Mac">${esc(label||f.name)} · not found on this Mac</span>`; }
document.addEventListener('click',e=>{
  const a=e.target.closest&&e.target.closest('a.srclink[data-src]');
  if(!a||e.metaKey||e.ctrlKey||e.shiftKey||e.button)return;
  e.preventDefault(); try{ srcOpen(JSON.parse(a.dataset.src)); }catch(_){}
});
// the Sources drop-down: its own relative links open in the viewer, then every cited file grouped by folder
async function srcFiles(){
  const box=main.querySelector('details.sources>div'); if(!box||!lessonId)return;
  if(srcv.filesFor!==lessonId){ srcv.filesFor=lessonId; srcv.files=null;
    try{ srcv.files=(await fetch(`/api/sources?id=${lessonId}${WSQ}`).then(r=>r.json())).files||[]; }catch(_){ srcv.files=[]; } }
  const files=srcv.files||[]; if(!files.length)return;
  const live=main.querySelector('details.sources>div'); if(!live)return;
  for(const a of live.querySelectorAll('a[href]:not(.srclink)')){
    const h=a.getAttribute('href'); if(/^(https?:|#|mailto:)/i.test(h))continue;
    const rel=h.replace(/^(\.\.\/)*(sources\/)?/,'');
    const f=files.find(x=>x.found&&(x.path===rel||x.ref===h)); if(f){ a.classList.add('srclink'); a.href=f.url; a.dataset.src=JSON.stringify(f); }
  }
  live.querySelector('.srcfiles')?.remove();
  const groups={}; for(const f of files){ const k=f.found&&f.path.includes('/')?f.path.split('/')[0]:'Other'; (groups[k]=groups[k]||[]).push(f); }
  const div=document.createElement('div'); div.className='srcfiles';
  div.innerHTML='<h4>Files used · click to open beside the chat</h4>'+Object.entries(groups).map(([k,fs])=>`<h4>${esc(k)}</h4><div class="sfrow">${fs.map(f=>srcLink(f)).join('')}</div>`).join('');
  const cred=live.querySelector('#imgcredits'); cred?live.insertBefore(div,cred):live.appendChild(div);
}
// file paths the chat cites (`exams2/fa18-kj-e2.pdf`, "page 3") become links into the same viewer
const CITE=/(?:[\w.-]+\/)*[\w.-]+\.(?:pdf|txt|md|png|jpe?g|gif|webp|csv|tex)\b|(?:[\w.-]+\/)+[\w-]+-[es]\d\b/g;
async function srcCites(root){
  const nodes=[], w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:n=>n.parentElement.closest('a,.katex,pre')?NodeFilter.FILTER_REJECT:NodeFilter.FILTER_ACCEPT});
  while(w.nextNode())if(CITE.test(w.currentNode.data)){ CITE.lastIndex=0; nodes.push(w.currentNode); }
  CITE.lastIndex=0; if(!nodes.length)return;
  const refs=[...new Set(nodes.flatMap(n=>n.data.match(CITE)||[]))].filter(r=>!srcv.check.has(r));
  if(refs.length){ try{ const r=await fetch(`/api/source-check?${refs.map(x=>'p='+encodeURIComponent(x)).join('&')}${WSQ}`).then(r=>r.json()); refs.forEach(x=>srcv.check.set(x,r[x]||{found:false})); }catch(_){ return; } }
  for(const n of nodes){ if(!n.parentNode)continue;
    const t=n.data, frag=document.createDocumentFragment(); let at=0, hit=false;
    for(const m of t.matchAll(CITE)){ const f=srcv.check.get(m[0]); if(!f||!f.found)continue;
      // a page named right after the path, here or in the next text ("…e2.pdf, page 3", "p. 3")
      const after=t.slice(m.index+m[0].length,m.index+m[0].length+40)+(n.parentElement.closest('code')?(n.parentElement.closest('code').nextSibling?.textContent||'').slice(0,40):'');
      const pg=after.match(/^[^\w]{0,6}(?:page|p\.|pp\.|pg\.?)\s*(\d{1,3})/i);
      frag.append(t.slice(at,m.index)); const tmp=document.createElement('span'); tmp.innerHTML=srcLink(Object.assign({},f,{page:pg?+pg[1]:null}),m[0]); frag.append(tmp.firstChild); at=m.index+m[0].length; hit=true; }
    if(hit){ frag.append(t.slice(at)); n.replaceWith(frag); }
  }
}
</script>
