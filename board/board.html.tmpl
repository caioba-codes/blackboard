  else if(/^\*\*Contents\*\*\s*\n/.test(raw.trim())) html=container('::: contents\n'+raw.trim().replace(/^\*\*Contents\*\*\s*\n/,'')+'\n:::');
  else if(/^⚠️/.test(raw.trim())) html=calloutHtml(raw.trim());
