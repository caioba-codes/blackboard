  return fallback;
}
function applyAccent(fm){
  const n=parseInt(lessonId,10), i=(isNaN(n)?1:n)-1;
  const cycled=ACCENTS[ACCENT_ORDER[((i%ACCENT_ORDER.length)+ACCENT_ORDER.length)%ACCENT_ORDER.length]];
  const acc=resolveAccent(fm.accent,cycled);
  const root=document.documentElement.style;
  root.setProperty('--acc',acc);
  root.setProperty('--acc2',resolveAccent(fm.accent2,acc));
  // `board: slate` in the front matter: a real-blackboard surface for this lesson (trial; may become the default)
  document.documentElement.classList.toggle('slate',String(fm.board||'').toLowerCase()==='slate');
}
// Captions only describe the image; author, license and source go in one "Image credits" line at the end of the lesson.
function shortCap(credit){
  if(!credit)return '';
  return String(credit).split(/ · | by |\s\(|, via /)[0].replace(/^File:/,'').replace(/\.(jpe?g|png|webp|tiff?)$/i,'').trim();
}
function imageCredits(b){
  const list=[];
  if(fmCache.credit&&String(fmCache.plain||'').toLowerCase()!=='true')list.push(fmCache.credit);
  for(const m of b.matchAll(/^::: photo[^\n]*\n([\s\S]*?)^:::\s*$/gm)){const c=m[1].match(/^credit:\s*(.+)$/m);if(c&&!list.includes(c[1].trim()))list.push(c[1].trim());}
  let el=document.getElementById('imgcredits');
  if(!list.length){if(el)el.remove();return}
  if(!el){el=document.createElement('p');el.id='imgcredits';el.className='credit imgcredits';}
  el.innerHTML='<b>Image credits</b> · '+list.map(esc).join(' · ');
  // all attribution in one place: inside the Sources drop-down when the lesson has one, else at the end
  const src=main.querySelector('details.sources>div');
  if(src){ el.className='credit imgcredits insrc'; src.appendChild(el); } else main.appendChild(el);
}
function header(fm,meta){
  // plain: true is a temporary board: no eyebrow, lesson number, photo or byline, just the content (and a title if given)
  if(String(fm.plain||'').toLowerCase()==='true') return fm.title?`<h1 id="title">${esc(fm.title)}</h1>`:'';
  const num=lessonId||(meta&&meta.id)||'';
  const parts=[]; if(num)parts.push(`Lesson <b>${num}</b>`);  // no course code or exam arrow in the kicker: course: and exam: stay metadata
  let h=`<div class="top"><div class="eyebrow">${parts.map(p=>`<span>${p}</span>`).join('')}</div></div>`;
  // banner first: the photo is the first thing on the page, title and byline under it
  if(fm.photo){const src=fm.photo.startsWith('http')?fm.photo:WSB+'/assets/'+fm.photo.replace(/^assets\//,'');h+=`<img class="hero" src="${src}" alt="">`;const bcap=fm.caption||shortCap(fm.credit);if(bcap)h+=`<p class="credit">${esc(bcap)}</p>`;}
  if(fm.title) h+=`<h1 id="title">${esc(fm.title)}</h1>`;
  if(fm.model){const who=/^(prof|dr)\.?\s/i.test(String(fm.model))?String(fm.model):'Prof. '+fm.model; h+=`<p class="byline">by <span>${esc(who)}</span></p>`;}
