<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blackboard</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Patrick+Hand&family=Press+Start+2P&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.11/katex.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script src="/lib/rough.js"></script>
<script src="/lib/fig.js"></script>
<script src="/lib/lesson-video.js"></script>
<style>
:root{--bg:#0c0c0c;--chalk:#e9e6df;--dim:#8a8a84;--acc:#9b3a4a;--acc2:#9b3a4a;--rule:#262626;--ok:#4ea672;--no:#c2564f;--display:'Playfair Display',Georgia,serif;--body:'Crimson Pro',Georgia,serif}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:var(--bg);color:var(--chalk);font-family:var(--body);font-size:20px;line-height:1.6;-webkit-font-smoothing:antialiased}
main{max-width:860px;margin:0 auto;padding:36px 32px 140px}
/* right rail: a ruler of the lesson. One mark per ## (major sections only; ### stay in the Contents drawer), vertical fill = reading position */
.rail{position:fixed;top:78px;bottom:28px;right:6px;width:34px;z-index:1001;pointer-events:auto;cursor:pointer;touch-action:none;--pos:0}
/* the rail replaces the system scrollbar on lesson pages: drag it or click anywhere on it to scroll */
html.railmode{scrollbar-width:none}
html.railmode::-webkit-scrollbar,html.railmode body::-webkit-scrollbar{display:none;width:0;height:0}
.rail.drag,.rail.drag *{cursor:grabbing}
.rail[hidden]{display:none}
/* track and fill take the lesson's accent; ticks sit left of the track like a ruler */
.rail::before{content:'';position:absolute;right:8px;top:0;bottom:0;width:3px;border-radius:2px;background:color-mix(in srgb,var(--acc) 22%,#161616)}
.rail .fill{position:absolute;right:8px;top:0;width:3px;height:calc(var(--pos)*100%);border-radius:2px;background:var(--acc);box-shadow:0 0 8px color-mix(in srgb,var(--acc) 55%,transparent);pointer-events:none}
.rail .tick{position:absolute;right:0;width:34px;height:14px;margin-top:-7px;padding:0;border:0;background:none;cursor:pointer;pointer-events:auto}
.rail .tick::before{content:'';position:absolute;right:15px;top:6px;width:8px;height:2px;border-radius:1px;background:var(--chalk);opacity:.32;transition:opacity .2s,width .15s,background .2s}
.rail .tick.h3::before{top:6.5px;width:4px;height:1px;opacity:.22}
.rail .tick.past::before{background:var(--acc);opacity:.9}
.rail .tick.cur::before{background:var(--acc);opacity:1;width:12px;height:3px;top:5.5px;box-shadow:0 0 6px var(--acc)}
.rail .tick.h3.cur::before{width:7px;height:2px;top:6px}
.rail .tick:hover::before{opacity:1;width:14px}
.rail .tick.h3:hover::before{width:8px}
.rail .tick::after{content:attr(data-t);position:absolute;right:38px;top:50%;transform:translateY(-50%);max-width:min(420px,70vw);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#111;border:1px solid var(--rule);color:var(--chalk);font:15px var(--body);padding:4px 10px;border-radius:6px;opacity:0;pointer-events:none;transition:opacity .15s}
.rail .tick:hover::after,.rail .tick:focus-visible::after{opacity:1}.rail .tick:focus-visible{outline:1px solid var(--dim);outline-offset:2px}
@media (max-width:980px){.rail{right:2px;width:24px}.rail::before,.rail .fill{right:5px}.rail .tick{width:24px}.rail .tick::before{right:11px;width:6px}.rail .tick.h3::before{width:3px}.rail .tick.cur::before{width:9px}.rail .tick::after{right:28px}}
a{color:inherit}
h1,h2,h3{font-family:var(--display);font-weight:500;line-height:1.15;margin:0;text-wrap:balance}
h1{font-size:44px;margin:18px 0 6px}
h2{font-size:30px;margin:52px 0 14px}
h3{font-size:23px;margin:28px 0 8px}
p{margin:0 0 14px;max-width:66ch}
ul,ol{max-width:66ch}
li{margin:4px 0}
strong{font-weight:600}
.top{display:flex;align-items:center;gap:14px;font-size:17px;color:var(--dim);margin-bottom:10px}
.back{display:inline-block;width:32px;height:32px;line-height:30px;text-align:center;border:1px solid var(--rule);border-radius:50%;text-decoration:none;color:var(--dim);font-size:18px}
.back:hover{color:var(--chalk);border-color:var(--dim)}
.eyebrow{display:flex;gap:18px;flex-wrap:wrap}
.eyebrow b{color:var(--acc);font-weight:500}
.byline{margin:-2px 0 14px;color:var(--dim);font-size:15px;font-style:italic}
.byline span{font-style:normal;letter-spacing:.06em;text-transform:uppercase;font-size:13px}
.hero{width:100%;height:260px;object-fit:cover;border-radius:4px;filter:saturate(.7) brightness(.72);margin:14px 0 4px;display:block}
.credit{font-size:13px;color:var(--dim);margin:0 0 18px}
.hand{color:var(--acc);font-size:21px;font-style:italic}
.tag{display:inline-block;font-size:16px;color:var(--acc);font-style:italic;margin-left:8px;vertical-align:middle;text-decoration:none}
.blk{position:relative;padding:2px 0;margin:6px 0}
/* display math: the scroll box is the wrapper, with vertical padding, so tall
   glyphs (integral signs, fraction numerators) are never shaved by overflow */
.mathrow{overflow-x:auto;overflow-y:hidden;padding:12px 16px;margin:8px 0}
.katex .mnote.stacked{margin-left:.6em;padding-left:.6em;font-size:.76em;color:color-mix(in srgb,var(--acc) 45%,var(--dim))}
.katex .mnote.first.stacked::before{position:static;display:inline-block;margin-right:.6em;vertical-align:1px}
.katex-display{margin:0;padding:0;overflow:visible;text-align:left}
.katex-display>.katex{text-align:left}.katex{font-size:1.12em}
.katex .boxpad{border-color:var(--acc)!important}
/* cheat sheet: cards of formulas to memorize, label in the table-header small caps, tags as muted margin notes */
/* the sheet is wider than the reading column, like a printed page: two columns of cards when there is room, else one */
.sheet{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,430px),1fr));gap:16px;margin:16px 0 24px;align-items:start;position:relative;left:50%;transform:translateX(-50%);width:min(1180px,calc((100vw - var(--chatw,0px)) / var(--z,1) - 96px));max-width:calc(100vw / var(--z,1) - 32px)}
@media (max-width:760px){.sheet{width:100%;left:0;transform:none}}
.sheetcard{min-width:0;border:1px solid #2a2a27;border-radius:10px;background:rgba(236,232,218,.025);padding:12px 16px 8px}
.sheetlbl{margin:0 0 4px;font:500 13px var(--body);letter-spacing:.11em;text-transform:uppercase;color:var(--dim)}
.sheetcard .mathrow{padding:6px 2px;margin:2px 0}
.sheetcard .katex-display>.katex{font-size:1em}
.sheetcard .sz2 .mathrow>.katex-display{font-size:1.2em}
.sheetcard .sz1 .mathrow>.katex-display{font-size:1.45em}
.sheetcard .katex .mnote{border-left:0;padding-left:0;margin-left:1.4em;color:var(--dim);font-size:.72em}
.sheetcard .katex .mnote.first::before{content:none}
.sheetcard .tablewrap{margin:4px 0 8px;padding:0}
.sheetcard .tablewrap table{border-top:0;border-bottom:0}
.sheetcard .tablewrap th{font-size:12px;padding:6px 16px 6px 0;min-width:0}
.sheetcard .tablewrap td{padding:6px 16px 6px 0;font-size:16px}
.sheetcard .tablewrap tbody tr:first-child td{padding-top:8px}
.sheetcard .callout{margin:8px 0 8px;max-width:100%}
.sheetcard p{margin:4px 0;max-width:none}
/* size levels: level 1 (::: big) is the chapter's fundamental rule as a big visual, level 2 (::: key) a tool formula.
   The scale sits on the KaTeX box, so fitMath's shrink-to-fit (on the row) still works on top of it. */
.sz .mathrow{padding-top:16px;padding-bottom:16px}
.sz1 .mathrow>.katex-display{font-size:1.75em}
.sz2 .mathrow>.katex-display{font-size:1.38em}
.sz1 .tablewrap td{font-size:1.12em}.sz1 .tablewrap td .katex{font-size:1.18em}
.sz1{margin:10px 0 14px}
/* tables: booktabs — rules only at top, under the header, and at the bottom.
   No vertical rules, no fills; row spacing does the separating. */
.tablewrap{overflow-x:auto;overflow-y:hidden;padding:8px 0 12px;margin:20px 0 26px}
.blk:has(>h2,>h3)+.blk>.tablewrap:first-child{margin-top:0}
.mathrow,.tablewrap,.mcqi .answer-copy,main pre{scrollbar-width:none}
.mathrow::-webkit-scrollbar,.tablewrap::-webkit-scrollbar,.mcqi .answer-copy::-webkit-scrollbar,main pre::-webkit-scrollbar{display:none}
.tablewrap table{border-collapse:collapse;width:auto;max-width:100%;font-variant-numeric:tabular-nums;border-top:1.5px solid var(--chalk);border-bottom:1.5px solid var(--chalk)}
.tablewrap th{font-family:var(--body);font-weight:500;font-size:15px;letter-spacing:.09em;text-transform:uppercase;color:var(--dim);text-align:left;vertical-align:bottom;padding:12px 28px 10px 0;border-bottom:1px solid var(--rule);white-space:normal;min-width:6.5em;line-height:1.3;text-wrap:balance}
.tablewrap th .katex{text-transform:none;letter-spacing:normal;font-size:1.05em;color:var(--chalk)}
/* math never breaks mid-formula: a math column that does not fit scrolls the
   table instead. Prose cells still wrap. */
.tablewrap .katex,.tablewrap .katex-html{white-space:nowrap}
.tablewrap td{padding:12px 28px 12px 0;vertical-align:baseline;text-align:left;line-height:1.35}
.tablewrap th:last-child,.tablewrap td:last-child{padding-right:0}
.tablewrap tbody tr:first-child td{padding-top:16px}
.tablewrap tbody tr:last-child td{padding-bottom:16px}
.tablewrap tbody tr:hover{background:rgba(255,255,255,.045)}
.tablewrap th[align=right],.tablewrap td[align=right]{text-align:right}
.tablewrap th[align=center],.tablewrap td[align=center]{text-align:center}
.tablewrap .mathrow{padding:0;margin:0;overflow:visible}
details{margin:6px 0 6px 14px}
summary{cursor:pointer;padding:3px 6px 3px 28px;font-size:19px;color:var(--chalk);list-style:none;position:relative;border-radius:4px}
summary::-webkit-details-marker{display:none}
summary:hover{background:rgba(255,255,255,.05)}
summary::before{content:"";position:absolute;left:9px;top:13px;border:5px solid transparent;border-left:7px solid var(--dim);transition:transform .15s}
details[open]>summary::before{transform:rotate(90deg) translate(-2px,2px)}
details>div{padding:2px 6px 8px 28px;color:var(--dim)}
details>div p{color:var(--dim)}
/* Prerequisites / Contents: one group of full-width rows on the lesson's left edge, hairline rules, chevron on the right,
   labels in the table-header small caps */
details.prerequisites{margin:0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
.blk:has(>details.prerequisites){margin:0;padding:0}
.blk:has(>details.prerequisites)+.blk:has(>details.prerequisites)>details{border-top:0}
.blk:has(>details.prerequisites):first-of-type,.blk:has(>details.prerequisites)+.blk:not(:has(>details.prerequisites)){margin-top:0}
.blk:has(>details.prerequisites)+.blk:not(:has(>details.prerequisites)){margin-top:18px}
details.prerequisites>summary{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-radius:0;font:500 15px var(--body);letter-spacing:.09em;text-transform:uppercase;color:var(--dim)}
details.prerequisites>summary::before{content:none}
details.prerequisites>summary::after{content:"";width:7px;height:7px;margin-right:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px);transition:transform .15s}
details.prerequisites[open]>summary::after{transform:rotate(-135deg) translate(-2px,-1px)}
details.prerequisites>summary:hover{color:var(--chalk);background:rgba(255,255,255,.035)}
details.prerequisites>summary:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
details.prerequisites>div{padding:0 0 12px 16px}
.blk:has(>details.prerequisites)+.blk:has(>h2)>h2:first-child{margin-top:34px}
details.prerequisites>div ul,details.prerequisites>div ol{margin:4px 0 0;padding-left:20px}
.fold{margin:14px 0 20px;border:2px solid color-mix(in srgb,var(--acc) 78%,var(--chalk));border-radius:16px 9px 18px 10px/10px 17px 9px 15px;background:rgba(6,8,7,.34);box-shadow:inset 0 0 18px rgba(236,235,227,.035),0 0 6px color-mix(in srgb,var(--acc) 18%,transparent);color:var(--chalk);overflow:hidden}
.exp{position:relative;font-size:20px}
.exphead{display:flex;align-items:center;gap:6px;padding:6px 10px}
.exptoggle{display:flex;align-items:center;gap:9px;flex:1;min-width:0;text-align:left;background:none;border:0;color:color-mix(in srgb,var(--acc) 65%,var(--chalk));font:inherit;font-size:17px;padding:8px 4px;cursor:pointer}
.exptoggle::before{content:"▾";width:12px;flex-shrink:0}
.fold.closed>.in>.exp>.exphead>.exptoggle::before{content:"▸"}
.exp .explabel{overflow-wrap:anywhere}
.expbody{padding:0 24px 14px;color:#ece8da}
.expbody p{max-width:66ch}
.expbody .mathrow{margin:8px 0 12px}
.fold.closed>.in>.exp>.expbody{display:none}
.expremove{border:0;background:none;color:var(--dim);cursor:pointer;font-size:22px;padding:5px 8px}
.exptoggle:focus-visible,.expremove:focus-visible{outline:2px solid var(--acc);outline-offset:1px;border-radius:4px}
.exp.pending .expbody{color:var(--dim)}
.exp.error .expbody{color:#e3b2a2}
.defined{cursor:pointer;text-decoration:underline dotted var(--acc);text-underline-offset:4px}
.defined:focus-visible{outline:1px solid var(--acc);outline-offset:3px}
/* selection is one colour everywhere: the lesson accent, text and math alike */
::selection{background:color-mix(in srgb,var(--acc) 42%,transparent);color:inherit}
/* math is selected by whole visual line: KaTeX glyph boxes get no native highlight, bands are drawn per row instead */
.katex::selection,.katex *::selection{background:transparent}
figure svg ::selection,figure svg::selection{background:transparent;fill:inherit}
#selbands{position:absolute;left:0;top:0;width:0;height:0;pointer-events:none;z-index:4}
.selband{position:absolute;border-radius:2px;background:color-mix(in srgb,var(--acc) 42%,transparent);pointer-events:none}
.pill{position:absolute;background:var(--chalk);color:var(--bg);font-size:15px;border-radius:4px;box-shadow:0 3px 10px rgba(0,0,0,.5);z-index:5;display:none;overflow:hidden;white-space:nowrap}
.pill span{display:inline-block;padding:4px 10px;cursor:pointer}
.pill span+span{border-left:1px solid rgba(0,0,0,.2)}
.pill span:hover{background:rgba(0,0,0,.08)}
.defpop{position:absolute;z-index:6;display:none;max-width:320px;background:#111;color:var(--chalk);border:1px solid #2c2c2c;border-left:3px solid var(--acc);border-radius:6px;box-shadow:0 6px 22px rgba(0,0,0,.6);padding:9px 12px 10px;font:15.5px/1.45 var(--body)}
.defpop .term{display:block;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);margin-bottom:3px}
.defpop .body .katex{font-size:1em}
.defpop.err{border-left-color:#b4544f;color:var(--dim)}
.katex [data-why]{cursor:pointer;border-bottom:1.5px dotted color-mix(in srgb,var(--acc) 75%,var(--dim));border-radius:1px;transition:border-color .15s,background .15s}
.katex [data-why]:hover{border-bottom-color:var(--chalk);background:color-mix(in srgb,var(--acc) 12%,transparent)}
.katex [data-why]:focus-visible{outline:1.5px solid var(--acc);outline-offset:2px}
.katex [data-why][aria-expanded="true"]{border-bottom-style:solid;border-bottom-color:var(--acc);background:color-mix(in srgb,var(--acc) 16%,transparent)}
.whypop{max-width:min(380px,calc(100vw - 16px));padding:10px 14px 12px}
.whypop .body{font-size:17px;line-height:1.5;overflow-x:auto}
.defpop.whypop .body .katex{font-size:1.2em}
.defpop .nubi{display:inline-block;width:7px;height:7px;margin-left:2px;border-radius:50%;background:var(--acc);animation:blink 1s steps(2) infinite}
.photo{margin:18px 0 22px}
.photo img{width:100%;height:auto;display:block;border-radius:6px;filter:saturate(.85) brightness(.9)}
.photo figcaption{font-size:15px;color:var(--dim);margin:8px 2px 0;line-height:1.45}
.photo figcaption .credit{display:block;font-size:12.5px;opacity:.75;margin-top:2px}
.imgcredits{margin:48px 0 0;font-size:12.5px;line-height:1.5;opacity:.8}
.imgcredits.insrc{margin:10px 0 0;font-size:14px;opacity:1;color:var(--dim)}
.imgcredits.insrc b{font-weight:500;color:var(--chalk)}
/* end card: Ultraman Mebius signs off every lesson (photo from the bridge's /end-card.jpg, quote alone without it).
   It sits outside the lesson's blocks: no rail tick, contents node, search hit, Explain/Definition target or XP. */
.endcard{margin:72px 0 0;container-type:inline-size;user-select:none;-webkit-user-select:none}
.endcard[hidden]{display:none}
.endcard .ec{position:relative;display:grid;grid-template-columns:minmax(0,11fr) minmax(0,13fr);min-height:360px;border-radius:22px 18px 24px 20px/20px 24px 18px 22px;overflow:hidden;color:#fff;
  background:radial-gradient(90% 70% at 88% 8%,rgba(96,160,255,.28),transparent 62%),radial-gradient(70% 60% at 10% 100%,rgba(10,30,90,.9),transparent 70%),linear-gradient(160deg,#16449a 0%,#0c2a66 42%,#071636 100%);
  box-shadow:0 0 0 1.5px rgba(233,230,223,.20),0 0 0 6px rgba(233,230,223,.035),0 24px 60px -28px rgba(40,100,230,.55)}
.endcard .ec::before{content:'';position:absolute;inset:7px;border:1px dashed rgba(233,230,223,.13);border-radius:17px 14px 19px 15px/15px 19px 14px 17px;pointer-events:none;z-index:2}
.endcard .ecph{position:relative;min-height:360px}
.endcard .ecph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 32%;display:block}
.endcard .ecph{-webkit-mask-image:linear-gradient(90deg,#000 52%,transparent 99%);mask-image:linear-gradient(90deg,#000 52%,transparent 99%)}
.endcard .ecq{display:flex;flex-direction:column;justify-content:center;padding:44px 44px 40px 36px;position:relative;z-index:1}
.endcard .ecquote{margin:0;font:italic 700 clamp(24px,5cqi,40px)/1.2 var(--display);letter-spacing:.005em;text-wrap:balance;text-shadow:0 2px 18px rgba(0,10,40,.45)}
.endcard .ecwho{margin:20px 0 0;font:500 17px/1 var(--body);font-variant:small-caps;letter-spacing:.16em;color:rgba(255,255,255,.72)}
.endcard .ectimer{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;margin-top:30px;padding:5px 15px 5px 5px;border-radius:999px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:rgba(255,255,255,.86);font:500 15px/1 var(--body);letter-spacing:.02em;cursor:pointer;transition:background .2s,border-color .2s}
.endcard .ectimer:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.34)}
.endcard .ectimer:focus-visible{outline:2px solid #8cc8ff;outline-offset:3px}
.endcard .gem{position:relative;width:26px;height:26px;border-radius:50%;background:radial-gradient(circle at 36% 30%,#e6f6ff 0 10%,#56b4ff 32%,#0d56c4 72%,#06306f 100%);box-shadow:0 0 12px rgba(80,170,255,.65),inset 0 0 0 2px rgba(255,255,255,.28)}
.endcard .gem::after{content:'';position:absolute;left:10px;top:8px;border-left:8px solid rgba(255,255,255,.92);border-top:5px solid transparent;border-bottom:5px solid transparent}
.endcard .ectimer.on .gem{animation:ecblink .38s steps(1) infinite}
.endcard .ectimer.on .gem::after{display:none}
@keyframes ecblink{0%{background:radial-gradient(circle at 36% 30%,#ffe6e6 0 10%,#ff5a5a 32%,#c41010 72%,#6f0606 100%);box-shadow:0 0 16px rgba(255,70,70,.8),inset 0 0 0 2px rgba(255,255,255,.28)}50%{background:radial-gradient(circle at 36% 30%,#a85050 0 10%,#7a1a1a 40%,#3a0505 100%);box-shadow:inset 0 0 0 2px rgba(255,255,255,.18)}}
.endcard.noimg .ec{grid-template-columns:1fr;min-height:0}
.endcard.noimg .ecph{display:none}
.endcard.noimg .ecq{align-items:center;text-align:center;padding:64px 48px 56px}
.endcard.noimg .ectimer{align-self:center}
@container (max-width:560px){
  .endcard .ec{grid-template-columns:1fr;min-height:0}
  .endcard .ecph{min-height:0;aspect-ratio:5/4}
  .endcard .ecph img{object-position:50% 26%}
  .endcard .ecph{-webkit-mask-image:linear-gradient(180deg,#000 55%,transparent 99%);mask-image:linear-gradient(180deg,#000 55%,transparent 99%)}
  .endcard .ecq{padding:8px 28px 34px}
  .endcard .ecquote{font-size:clamp(22px,7cqi,32px)}
}
details.sources>div li{margin:3px 0}
.photo.side{float:right;width:44%;max-width:380px;margin:6px 0 16px 28px;clear:right}
.sidepair{display:grid;grid-template-columns:minmax(0,1fr) 40%;gap:28px;align-items:start;margin:6px 0}
.sidepair .photo.side{float:none;width:auto;max-width:none;margin:8px 0 0}
.sidepair .blk{margin:0}
.sidepair p{max-width:none}
.photo.wide{clear:both}
.photo .finding{background:#111;border:1px dashed var(--rule);border-radius:6px;padding:26px 16px;color:var(--dim);font-style:italic;text-align:center}
h2,h3,.quiz,.deck,.figure{clear:both}
.figure{display:grid;grid-template-columns:minmax(0,3fr) minmax(0,2fr);gap:22px;align-items:center;margin:18px 0 18px 14px}
.figure.wide{grid-template-columns:1fr;gap:10px}
.figure img{width:100%;border-radius:3px;background:#0c0c0c}
.figure svg.fig{width:100%;height:auto;display:block}
.figure .fail{color:var(--acc);font-size:16px;white-space:pre-wrap}
video.video{width:100%;border-radius:3px;background:#000;margin:12px 0;display:block}
.figure figcaption{color:var(--dim);font-size:17px}
.btns{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 12px}
.btn{font-size:17px;padding:5px 14px;border:1px solid var(--rule);border-radius:2px;background:transparent;color:var(--chalk);cursor:pointer;font-family:var(--body)}
.btn.on{border-color:var(--acc);color:var(--acc)}
/* verdict layer — quiz answers only. Always filled with an icon, so it never
   reads as the lesson's highlight even when the accent is the same hue. */
.btn:disabled{cursor:default}
.btn:disabled:hover{border-color:var(--rule)}
.btn.picked{border-color:var(--chalk);color:var(--chalk)}
.btn.picked:hover{border-color:var(--chalk)}
.btn.ok,.btn.no{border-color:transparent;color:#0c0c0c;font-weight:600}
.btn.ok:hover,.btn.no:hover{border-color:transparent}
.btn.ok{background:var(--ok);animation:pop .34s cubic-bezier(.2,.9,.3,1)}
.btn.no{background:var(--no)}
.btn.ok::before{content:"\2713  "}
.btn.no::before{content:"\2715  "}
.btn.key{border-color:var(--ok);color:var(--ok)}
.btn.key:hover{border-color:var(--ok)}
.btn.key::before{content:"\2713  "}
@keyframes pop{0%{transform:scale(1)}42%{transform:scale(1.07)}100%{transform:scale(1)}}
.vb{display:inline-block;margin-left:10px;width:21px;height:21px;line-height:21px;text-align:center;border-radius:50%;color:#0c0c0c;font-size:13px;font-weight:700;vertical-align:-4px}
.btn.primary{border-color:var(--chalk)}
.btn:hover{border-color:var(--dim)}
/* "On the test" callout: amber tint, thin amber border with a left accent, line-art warning icon, small-caps label */
:root{--amber:#d4a24a}
.callout{width:auto;max-width:none;box-sizing:border-box;margin:14px 0 22px;padding:12px 22px 14px 20px;border:1px solid color-mix(in srgb,var(--amber) 30%,transparent);border-left:3px solid var(--amber);border-radius:4px 8px 8px 4px;background:color-mix(in srgb,var(--amber) 7%,#0d0d0c)}
.cohead{display:flex;align-items:center;gap:7px;margin:0 0 4px;font:600 12px/1 var(--body);letter-spacing:.13em;text-transform:uppercase;color:var(--amber)}
.cohead svg{flex:0 0 15px;width:15px;height:15px}
.corow{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:6px 24px;padding:8px 0 4px}
.corow .cowrong{justify-self:center}.corow .coright{justify-self:center}
.corow .cowrong,.corow .coright{display:inline-flex;align-items:center;gap:9px}
.corow .comk{font:700 15px/1 var(--body)}
.cowrong{color:var(--dim)}.cowrong .comk{color:color-mix(in srgb,var(--no) 75%,var(--dim))}
.cowrong .cm{position:relative;opacity:.8}
.cowrong .cm::after{content:'';position:absolute;left:-3px;right:-3px;top:50%;border-top:1.5px solid color-mix(in srgb,var(--no) 70%,var(--dim));transform:rotate(-4deg)}
.coright{color:var(--chalk)}.coright .comk{color:var(--ok)}
.coarr{color:color-mix(in srgb,var(--amber) 70%,var(--dim));font-size:18px}
.cotext{color:#d8d3c4;font-size:17px;line-height:1.45}
.cotext p{margin:2px 0 0;max-width:none}
.corow+.cotext{margin-top:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (max-width:600px){.corow{grid-template-columns:1fr}.corow .cowrong,.corow .coright{justify-self:start}.coarr{display:none}}
.quiz .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.quiz .lbl{color:var(--dim);font-size:16px;min-width:64px}
.mcqi{margin:8px 0 22px 14px}
.mcqi .q{margin:0 0 8px}
/* a stem or check-in question with code: the code is a normal code box, the question sentence on its own line */
.qblock>p{margin:8px 0}.qblock>pre{margin:10px 0}.mcqi .q.qblock::before{display:block;margin-bottom:4px}
.check summary .qblock{display:inline-block;vertical-align:top;width:calc(100% - 24px)}
.mcqi .optcode{margin:0;font-size:.85em;white-space:pre-wrap;background:none;padding:0}
.mcqi .answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}
.mcqi .answers.long{grid-template-columns:1fr}
.mcqi label{position:relative;display:flex;align-items:center;gap:16px;min-height:94px;padding:20px;border-radius:8px;cursor:pointer;border:1px solid #55564f;background:rgba(255,255,255,.025);box-sizing:border-box;transition:background .15s,border-color .15s}
.mcqi label:hover{background:rgba(255,255,255,.065);border-color:var(--chalk)}
.mcqi label:focus-within{outline:2px solid var(--chalk);outline-offset:3px}
.mcqi label:has(input:checked){border-color:var(--chalk);background:rgba(255,255,255,.08)}
.mcqi input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.mcqi .answer-icon{flex:0 0 34px;width:34px;height:34px;display:grid;place-items:center;color:var(--answer-color);font-family:Arial,sans-serif;font-size:29px;line-height:1}
.mcqi .answer-copy{min-width:0;overflow-wrap:anywhere;font-size:21px;line-height:1.45;overflow-x:auto;overflow-y:hidden;padding:6px 0}
.mcqi .answer-copy .katex{font-size:1em}
.mcqi.done label.right{border-color:var(--ok)}
.mcqi.done label.wrong{border-color:var(--no)}
.mcqi.done label::after{flex-shrink:0}
@media(max-width:720px){.mcqi .answers{grid-template-columns:1fr}.mcqi label{padding:16px;min-height:80px}.mcqi .answer-copy{font-size:19px}}
.mcqi.done label.right{color:var(--chalk)}
.mcqi.done label.right::after{content:"\2713";display:inline-block;margin-left:10px;width:21px;height:21px;line-height:21px;text-align:center;border-radius:50%;background:var(--ok);color:#0c0c0c;font-size:13px;font-weight:700;vertical-align:-4px;animation:pop .34s cubic-bezier(.2,.9,.3,1)}
.mcqi.done label.wrong::after{content:"\2715";display:inline-block;margin-left:10px;width:21px;height:21px;line-height:21px;text-align:center;border-radius:50%;background:var(--no);color:#0c0c0c;font-size:13px;font-weight:700;vertical-align:-4px}
.mcqi.done label.wrong{color:var(--dim)}
.mcqi .fb{margin-top:8px;min-height:1.4em;font-size:19px}
.mcqi .fb .ok{color:var(--ok);font-weight:600}.mcqi .fb .bad{color:var(--no);font-weight:600}
/* answer feedback uses the explanation-callout look: olive block, titled header, ivory body */
.mcqi .fb:empty{display:none}
.mcqi .mreset{margin-top:8px;padding:4px 12px;border:1px solid var(--rule);border-radius:6px;background:transparent;color:var(--dim);font:15px var(--body);cursor:pointer}
.mcqi .mreset:hover,.mcqi .mreset:focus-visible{color:var(--chalk);border-color:var(--dim)}
.mcqi .mreset[hidden]{display:none}
.mcqi .fbc{margin-top:10px;border:1px solid #b8aa7130;border-radius:8px;background:#30352b;overflow:hidden}
.mcqi .fbh{display:flex;align-items:center;gap:9px;padding:9px 16px 4px;font-size:17px;font-weight:600}
.mcqi .fbc.ok .fbh{color:var(--ok)}.mcqi .fbc.bad .fbh{color:#e3b2a2}
.mcqi .fbb{padding:0 22px 12px 16px;color:#ece8da;font-size:19px;font-weight:400}
.mcqi .fbb p{margin:4px 0;max-width:66ch}.mcqi .fbb .mathrow{margin:8px 0}
/* ---- quiz: multiple choice list ---- */
#main{counter-reset:mcq}
.mcqi{counter-increment:mcq}
.mcqi .q::before{content:counter(mcq) ".";color:var(--dim);margin-right:10px;font-variant-numeric:tabular-nums}
/* ---- flashcard deck: one card at a time, flips on Validate, slides to the next ---- */
.deck{margin:12px 0 8px 14px;max-width:700px}
.deckbar{display:flex;justify-content:space-between;align-items:baseline;color:var(--dim);font-size:15px;margin:0 4px 10px;font-variant-numeric:tabular-nums}
.deckbar b{color:var(--chalk);font-weight:500}
.deckbar .avg i{display:inline-block;width:7px;height:7px;border-radius:50%;border:1px solid var(--rule);margin-left:4px;vertical-align:1px}
.deckbar .avg i.on{background:var(--ok);border-color:var(--ok)}
.stage{perspective:1600px;position:relative}
.fc{display:none;position:relative;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.25,.8,.25,1),opacity .22s ease}
.fc.cur{display:block}
.fc.flip{transform:rotateY(180deg)}
.fc.out{transform:translateX(-56px) rotate(-1.5deg);opacity:0}
.fc.in{animation:cardin .38s cubic-bezier(.2,.8,.2,1)}
@keyframes cardin{from{transform:translateX(56px) rotate(1.5deg);opacity:0}to{transform:none;opacity:1}}
.fc.busy{animation:breathe 1.4s ease-in-out infinite}
@keyframes breathe{0%,100%{filter:brightness(1)}50%{filter:brightness(1.18)}}
/* front sits in flow and sets the height; back is laid over it. backface-visibility
   alone is not reliable in every WebKit, so the faces also swap visibility at the
   midpoint of the turn (the .3s delay is half the .6s flip). */
.face{backface-visibility:hidden;-webkit-backface-visibility:hidden;border:1px solid var(--rule);border-radius:12px;background:#121212;padding:28px 30px 24px;box-sizing:border-box;min-height:280px;display:flex;flex-direction:column;box-shadow:0 12px 40px -18px #000;transition:visibility 0s linear .3s}
.face.front{position:relative}
.face.back{position:absolute;inset:0;width:100%;height:100%;transform:rotateY(180deg);overflow:auto}
.fc.flip .face.front{visibility:hidden}
.fc:not(.flip) .face.back{visibility:hidden}
/* once the turn has finished, drop the 3D transforms: text in a rotated layer
   loses subpixel antialiasing in WebKit and reads lighter than the front */
.fc.flip.settled,.fc.flip.settled .face.back{transform:none}
.fc.snap,.fc.snap .face{transition:none!important}
.face.back{text-align:left}
.face.back .key,.verdict p{color:var(--chalk)}
.verdict .said,.verdict .missing,.verdict .peek{color:var(--dim)}
.face .q{font-size:24px;line-height:1.35;margin:0;flex:1;display:flex;align-items:center}
.face .q .katex{font-size:1.05em}
.ansrow{display:flex;gap:10px;align-items:flex-end;margin-top:22px;border-top:1px solid var(--rule);padding-top:16px}
.ansrow textarea.ans{flex:1;min-height:44px;box-sizing:border-box;background:transparent;color:var(--chalk);border:0;border-bottom:1px solid var(--rule);padding:6px 2px;font-family:var(--body);font-size:19px;line-height:1.4;resize:none;overflow:hidden}
.ansrow textarea.ans:focus{outline:none;border-bottom-color:var(--chalk)}
.ansrow textarea.ans::placeholder{color:var(--dim)}
.btn.mic{white-space:nowrap}.btn.mic::before{content:"\25CF  ";color:var(--no)}
.btn.mic.rec{border-color:var(--no);color:var(--no)}.btn.mic.rec::before{animation:blink 1s steps(2) infinite}
.face .lbl{color:var(--dim);font-size:13px;letter-spacing:.09em;text-transform:uppercase;margin:0 0 8px}
.face .key{font-size:20px;line-height:1.45}
.face .key ul{margin:0;padding-left:20px}
.verdict{margin-top:18px;border-top:1px solid var(--rule);padding-top:14px}
.verdict .said{color:var(--dim);font-style:italic;margin:0 0 8px}
.verdict .grade{display:flex;align-items:center;gap:12px;margin:0 0 6px}
.verdict .grade b{font-weight:600}
.verdict .grade.low b{color:var(--no)}
.pips{display:inline-flex;gap:5px}
.pips i{width:9px;height:9px;border-radius:50%;border:1px solid var(--rule);display:block}
.pips i.on{background:var(--ok);border-color:var(--ok)}
.grade.low .pips i.on{background:var(--no);border-color:var(--no)}
.verdict p{margin:0 0 6px}
.verdict .missing{color:var(--dim)}
.verdict .peek{color:var(--dim);font-style:italic}
.deckctl{display:flex;align-items:center;gap:10px;margin:14px 4px 0}
.deckctl .sp{flex:1}
.deckctl .nav{min-width:44px;text-align:center;font-size:18px;line-height:1}
.deckctl .skip{color:var(--dim);border-color:transparent}
.deckctl .skip:hover{border-color:var(--rule)}
.deckctl .hint{color:var(--dim);font-size:14px}
.fc.summary .face{align-items:center;justify-content:center;text-align:center}
.fc.summary h3{margin:0 0 6px}
.fc.summary p{color:var(--dim);margin:0 0 18px}
.fc.summary .row{display:flex;gap:10px;justify-content:center}
/* legacy ::: score blocks outside a deck */
.score{margin:2px 0 26px 14px}
.score .grade{display:flex;align-items:center;gap:12px;margin:0 0 6px}
/* ---- more practice: mode tiles, topic chips, one action ---- */
.quiz .more{margin:30px 0 0 14px;padding-top:22px;border-top:1px solid var(--rule)}
.quiz .morelbl{color:var(--dim);font-size:13px;letter-spacing:.09em;text-transform:uppercase;margin:0 0 14px}
.tiles{display:flex;gap:12px;margin:0 0 16px;max-width:700px}
.tile{flex:1;text-align:left;border:1px solid var(--rule);border-radius:10px;padding:14px 16px 13px;background:transparent;color:var(--chalk);cursor:pointer;font-family:var(--body);transition:border-color .15s}
.tile:hover{border-color:var(--dim)}
.tile b{display:block;font-size:19px;font-weight:500}
.tile span{display:block;color:var(--dim);font-size:15px;margin-top:3px}
.tile.on{border-color:var(--acc);box-shadow:inset 0 0 0 1px var(--acc)}
.chips{display:flex;flex-wrap:wrap;gap:8px;align-items:center;max-width:700px}
.chips .lbl{color:var(--dim);font-size:15px;margin-right:2px}
.chips .btn{font-size:15px;padding:4px 10px}
.go{display:flex;align-items:center;gap:12px;margin-top:14px;max-width:700px}
.go .sp{flex:1}
.quiz.busy .gen{opacity:.6;pointer-events:none}
.genbox{max-width:700px}
/* loading: same shimmer idiom as the lesson skeleton, so waiting always looks the same */
.sk span{display:block;height:13px;border-radius:3px;margin:13px 0;background:linear-gradient(90deg,#181818 0%,#2b2b28 45%,#181818 90%);background-size:220% 100%;animation:shimmer 1.8s linear infinite}
.sk span:nth-child(1){width:70%}.sk span:nth-child(2){width:92%;animation-delay:.15s}.sk span:nth-child(3){width:54%;animation-delay:.3s}
.skcard{border:1px solid var(--rule);border-radius:12px;padding:28px 30px;min-height:120px;margin-top:14px}
.busylbl{color:var(--dim);font-style:italic;font-size:16px;margin:10px 0 0}
.busylbl::after{content:'';display:inline-block;width:1.4em;text-align:left;animation:ellipsis 1.6s steps(1) infinite}
@media (prefers-reduced-motion:reduce){.fc,.fc.in,.fc.busy{transition:none!important;animation:none!important}}
.answer{color:var(--dim);font-style:italic}
.video{aspect-ratio:16/9;width:100%;border:0;border-radius:2px;margin:12px 0}
.src{font-size:17px;color:var(--dim)}.src b{color:var(--chalk);font-weight:500}
hr{border:0;border-top:1px solid var(--rule);margin:40px 0}
.check{margin:14px 0 18px}
/* check-ins (Your turn, drills, practice-exam answers): one list of full-width rows on the lesson's left edge, like
   Prerequisites/Contents: hairline rules between rows, chevron on the right, the answer in a tinted inset panel */
.check>details{margin:0;border-bottom:1px solid var(--rule)}
.check>details:first-child{border-top:1px solid var(--rule)}
.check>details>summary{display:flex;align-items:center;gap:14px;padding:12px 6px 12px 2px;border-radius:0;font-size:19px;line-height:1.45;color:var(--chalk)}
.check>details>summary::before{content:none}
.check>details>summary::after{content:"";flex:0 0 7px;width:7px;height:7px;margin:0 6px 0 auto;border-right:1.5px solid var(--dim);border-bottom:1.5px solid var(--dim);transform:rotate(45deg) translateY(-2px);transition:transform .15s,border-color .15s}
.check>details[open]>summary::after{transform:rotate(-135deg) translate(-2px,-1px);border-color:var(--chalk)}
.check>details>summary:hover{background:rgba(255,255,255,.035)}
.check>details>summary:hover::after{border-color:var(--chalk)}
.check>details>summary:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
.check>details>summary>.sq{flex:1;min-width:0}
.check>details>summary .katex{font-size:1.05em}
.check>details>div{margin:0 0 14px;padding:14px 20px 12px;border:1px solid #2a2a26;border-radius:8px;background:rgba(236,232,218,.035);color:var(--chalk)}
.check>details>div p{color:var(--chalk);max-width:none}
.check>details>div>.mathrow{padding:10px 4px;margin:6px 0}
.check>details>div>:first-child{margin-top:0}
/* step-by-step reveal */
.rv .rv-off{display:none}
.rv .mathrow.rv-clip{transition:height .3s cubic-bezier(.2,.8,.2,1)}
.rv-in{animation:rvin .45s ease-out both}
@keyframes rvin{from{opacity:0;filter:blur(2px);transform:translateY(3px)}to{opacity:1;filter:none;transform:none}}
.stepctl{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:12px 0 4px}
.stepnext{display:inline-flex;align-items:center;gap:10px;height:36px;padding:0 13px 0 16px;border:1px solid color-mix(in srgb,var(--acc) 62%,#3a3a3a);border-radius:999px;background:color-mix(in srgb,var(--acc) 12%,#101010);color:var(--chalk);font:500 16px/1 var(--body);cursor:pointer;box-shadow:0 0 12px color-mix(in srgb,var(--acc) 16%,transparent);transition:background .15s,border-color .15s,box-shadow .15s}
.stepnext:hover{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 22%,#101010);box-shadow:0 0 16px color-mix(in srgb,var(--acc) 30%,transparent)}
.stepnext:focus-visible{outline:2px solid var(--chalk);outline-offset:2px}
.stepnext .stct{padding-left:10px;border-left:1px solid color-mix(in srgb,var(--acc) 40%,#333);font:500 12px/1 var(--body);letter-spacing:.09em;text-transform:uppercase;color:#b9b5aa;font-variant-numeric:lining-nums tabular-nums}
.stepnext svg{width:14px;height:14px;color:color-mix(in srgb,var(--acc) 60%,var(--chalk))}
.stepall{background:none;border:0;padding:4px 2px;color:var(--dim);font:15px var(--body);cursor:pointer;text-decoration:underline dotted;text-decoration-color:transparent;text-underline-offset:4px}
.stepall:hover,.stepall:focus-visible{color:var(--chalk);text-decoration-color:currentColor;outline:none}
.srlive{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.mcqi .fbb .fbhint{color:#b9b5aa;font-size:17px}
.mcqi .fbb .fbmiss{color:#ece8da;margin-bottom:2px}
@media print{.rv .rv-off{display:revert!important}.rv .mathrow{height:auto!important}.rv .katex *{visibility:visible!important}.stepctl{display:none!important}.check>details>div{display:block}}
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#1a1a1a;border:1px solid var(--rule);color:var(--chalk);padding:12px 16px;border-radius:6px;font-size:16px;max-width:90vw;display:none;z-index:8}
.toast code{font-family:ui-monospace,Menlo,monospace;font-size:14px;color:var(--dim)}
.toast .btn{margin-left:10px;font-size:14px;padding:3px 10px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:22px;margin-top:24px}
.hubbar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin:6px 0 10px}
.hubq{flex:1;min-width:220px;background:#101010;border:1px solid var(--rule);border-radius:6px;color:var(--chalk);font:inherit;font-size:18px;padding:9px 14px;outline:none}
.hubq:focus{border-color:var(--dim)}
.hubbar .chips{display:flex;flex-wrap:wrap;gap:8px;margin:0}
.hubbar .chip{background:none;border:1px solid var(--rule);border-radius:999px;color:var(--dim);font:inherit;font-size:15px;padding:4px 12px;cursor:pointer}
.hubbar .chip.on{border-color:var(--acc);color:var(--acc)}
.hubsec{margin-top:34px}
.hubsec h2{font-size:26px;margin:0 0 12px}
.hubsec h3{font-size:21px;margin:22px 0 10px}
.hubsec h3 a{color:inherit;text-decoration:none}
.hubsec h3 a:hover{color:var(--acc)}
.openall{margin-left:14px;vertical-align:middle;font:500 13px var(--body);color:var(--dim);background:transparent;border:1px solid var(--rule);border-radius:999px;padding:4px 12px;cursor:pointer;text-transform:none;letter-spacing:0}
.openall:hover{color:var(--acc);border-color:var(--acc)}
.openall .note{margin-left:8px;color:var(--acc)}
.hubsec .sub{font-family:var(--body);font-weight:400;font-size:15px;color:var(--dim);margin-left:12px;text-transform:none;letter-spacing:0}
.row{display:flex;gap:14px;overflow-x:auto;padding:4px 2px 12px;scroll-snap-type:x proximity}
.row .card{flex:0 0 220px;scroll-snap-align:start}
.card.mini .strip{height:78px}
.card.mini .t{font-size:17px}
.card.mini .m{font-size:13px}
.card[hidden],.course[hidden],.hubsec[hidden]{display:none}
.card{position:relative;display:block;text-decoration:none;color:inherit;border:1px solid var(--rule);border-radius:3px;overflow:hidden;background:#101010}
.card:hover{border-color:var(--dim)}
.card .nt{position:absolute;top:8px;right:8px;width:30px;height:30px;display:grid;place-items:center;border-radius:6px;background:rgba(10,10,10,.72);border:1px solid var(--rule);color:var(--ink);opacity:0;transition:opacity .15s;cursor:pointer}
.card:hover .nt,.card:focus-within .nt,.card .nt:focus-visible{opacity:1}
.card .nt:hover{border-color:var(--acc);color:var(--acc)}
@media (hover:none){.card .nt{opacity:1}}
.card .strip{height:120px;background:#161616;object-fit:cover;width:100%;display:block;filter:saturate(.7) brightness(.7)}
.card .body{padding:12px 14px 14px}
.card .t{font-family:var(--display);font-size:20px;line-height:1.2;margin:0 0 6px}
.card .m{font-size:15px;color:var(--dim);display:flex;justify-content:space-between;align-items:center}
.card .dots{display:flex;gap:4px}
.card .dot{width:8px;height:8px;border-radius:50%;background:var(--rule)}
.card .dot.p{background:var(--acc)}
.empty{color:var(--dim);font-style:italic}

.interactive{margin:22px 0;padding:20px;border:1px solid #b8aa7140;border-radius:8px;background:#1c211d}
.interactive h4{margin:0 0 12px;color:#d1bb83;font:22px var(--display)}
/* code stays inside the lesson column at every zoom: it scrolls inside its own block, never the page, and is
   sized against the prose (0.8em of the 20px body, Menlo) so a ~70-character line fits at 100% */
main pre{max-width:100%;box-sizing:border-box;overflow-x:auto;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.8em;line-height:1.5;tab-size:4}
main pre code{font:inherit}
.interactive pre{overflow:auto;margin:12px 0;white-space:pre}
.trace-line{display:block;padding:0 8px;border-left:3px solid transparent}
.trace-line.active{background:#d1bb8318;border-color:#d1bb83;color:#f4e8bf}
.trace-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.trace-state{display:flex;gap:16px;flex-wrap:wrap;margin:12px 0}
.trace-state pre{margin:0;min-width:120px}
.interactive label{display:block}.interactive input[type=range]{width:min(100%,360px);accent-color:#c8bc83}
.interactive svg{display:block;width:100%;max-width:640px;height:auto}
.interactive .axis{stroke:#777c70;stroke-width:1}.interactive .curve{fill:none;stroke:#d1bb83;stroke-width:3}

/* chalk write-in */
.w{display:inline-block;clip-path:inset(0 100% 0 0);animation:chalk-write var(--duration,150ms) steps(var(--letters,5),end) var(--delay,0ms) both}
@keyframes chalk-write{from{clip-path:inset(0 100% 0 0);filter:blur(.5px)}to{clip-path:inset(0 0 0 0);filter:blur(0)}}
@keyframes settle{from{opacity:0;filter:blur(3px);transform:translateY(2px)}60%{opacity:.85;filter:blur(.6px)}to{opacity:1;filter:blur(0)}}
h1.new,h2.new,h3.new{--wipe:linear-gradient(90deg,#000 40%,transparent 60%);mask-image:var(--wipe);-webkit-mask-image:var(--wipe);mask-size:250% 100%;-webkit-mask-size:250% 100%;animation:wipe var(--d,900ms) cubic-bezier(.3,0,.2,1) forwards}
@keyframes wipe{from{mask-position:100% 0;-webkit-mask-position:100% 0}to{mask-position:0 0;-webkit-mask-position:0 0}}
.mathrow.new{clip-path:inset(0 100% 0 0);animation:sweep var(--d,1200ms) linear forwards}
@keyframes sweep{to{clip-path:inset(0 0 0 0)}}
.blk.new{animation:rise .5s ease-out both}
@keyframes rise{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
#writing{margin:28px 0 80px}
#writing .sk span{display:block;height:13px;border-radius:3px;margin:13px 0;background:linear-gradient(90deg,#181818 0%,#2b2b28 45%,#181818 90%);background-size:220% 100%;animation:shimmer 1.8s linear infinite}
#writing .sk span:nth-child(1){width:88%}#writing .sk span:nth-child(2){width:96%;animation-delay:.15s}#writing .sk span:nth-child(3){width:62%;animation-delay:.3s}
#writing .wl{color:var(--dim);font-style:italic;font-size:16px;margin-top:18px}
#writing .wl::after{content:'';display:inline-block;width:1.4em;text-align:left;animation:ellipsis 1.6s steps(1) infinite}
@keyframes shimmer{from{background-position:200% 0}to{background-position:-20% 0}}
@keyframes ellipsis{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}
#nub{position:fixed;width:9px;height:20px;border-radius:2px;background:#f2eee4;box-shadow:0 0 6px #fff6;transform:rotate(20deg);pointer-events:none;transition:left .12s,top .12s,opacity .4s;z-index:9;opacity:0}
#nub.on{opacity:1}
#nub.idle{animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:.2}}
/* The chalk-writing reveal plays even with Reduce Motion on (Caio asked for it, like the XP celebration): it is short and never loops. */
@media (prefers-reduced-motion:reduce){.btn.ok,.mcqi.done label.right::after{animation:none!important;mask:none!important;-webkit-mask:none!important;clip-path:none!important;opacity:1!important;filter:none!important;transform:none!important}#nub{display:none}}

/* contents: drawer from the left + section ticks on the reading-progress bar */
main h2,main h3{scroll-margin-top:70px}
/* `board: slate` lessons: a real blackboard photo (board/slate.jpg: "Black smooth textured paper background", magnific.com (Freepik) free license, attribution required; vignette flattened),
   darkened so text stays readable, fixed behind the page; text gets a faint chalk bloom */
html.slate{--bg:#141614;--rule:#2c302c;--chalkmask:url("data:image/png;base64,")}
/* The photo is the root background, scrolling natively with the text (same speed, composited, no JS).
   slate.jpg is the photo stacked on its own mirror, so it tiles down the page without a seam. */
html.slate{background:linear-gradient(rgba(6,6,6,.42),rgba(6,6,6,.42)),url("/lib/slate.jpg") 0 0/100% auto repeat-y,#121212}
html.slate body{background:transparent} /* an opaque body would cover the root background */
html.slate #topbar{background:linear-gradient(rgba(12,14,13,.92) 60%,rgba(12,14,13,0))}
html.slate main{color:#ecebe3;text-shadow:0 0 1px rgba(236,235,227,.35)}
html.slate main .katex{text-shadow:0 0 1px rgba(236,235,227,.3)}
/* chalk grain: a fine speckle mask (board/chalk.png, inlined as --chalkmask so it can never fail to load: a missing mask hides the text) knocks tiny gaps into text, math and diagrams, like chalk skipping
   on the slate. A static mask, no filters, so scrolling stays composited. Not on photos, buttons or form controls. */
html.slate main .blk :is(p,li,h1,h2,h3,h4,td,th,figcaption,.mathrow,.figure svg,.predict,.check){-webkit-mask:var(--chalkmask) 0 0/128px 128px repeat;mask:var(--chalkmask) 0 0/128px 128px repeat}
html.slate #title,html.slate main header h1{-webkit-mask:var(--chalkmask) 0 0/128px 128px repeat;mask:var(--chalkmask) 0 0/128px 128px repeat}
/* margin notes (`&& reason` in derivations): a chalk margin — dashed rule, accent chalk, smaller, "why" label on the first */
.katex .mnote{display:inline-block;position:relative;margin-left:1.1em;padding-left:.85em;font-size:.8em;color:color-mix(in srgb,var(--acc) 70%,var(--chalk));border-left:2px dashed color-mix(in srgb,var(--acc) 45%,transparent)}
.katex .mnote.first::before{content:'why';position:absolute;left:.85em;top:-1.35em;font:600 11px var(--body);letter-spacing:.14em;text-transform:uppercase;color:var(--acc);opacity:.75}
/* Step lead-ins: boxed in a hand-drawn chalk frame in the lesson's accent */
main p > strong.step{position:relative;display:inline-block;padding:1px 9px 2px;margin:0 4px 0 -2px;color:var(--chalk)}
/* ---------- one pen ----------
   Everything new is written by a single pen, top to bottom: words letter by letter (.w), math swept left to right (.ink),
   shapes and diagram strokes drawn along their path (.drawn), figure labels faded in (.ink-fade). JS gives each piece its
   --delay/--duration on one shared clock, so two blocks never write at the same time. */
.ink{clip-path:inset(-4px 100% -4px 0);animation:inksweep var(--duration,600ms) linear var(--delay,0ms) both}
.katex.ink{display:inline-block}
@keyframes inksweep{from{clip-path:inset(-4px 100% -4px 0)}to{clip-path:inset(-4px 0 -4px 0)}}
.drawn{stroke-dasharray:100;stroke-dashoffset:100;animation:draw var(--duration,600ms) cubic-bezier(.45,.05,.4,1) var(--delay,0ms) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.ink-fade{opacity:0;animation:inkfade var(--duration,250ms) ease-out var(--delay,0ms) forwards}
@keyframes inkfade{to{opacity:1}}
/* chalk shapes: hand-drawn SVG paths sized to their text (JS), so they can be drawn like a hand draws them */
#toc .chalkdeco{display:none}
.chalkdeco{position:absolute;pointer-events:none;overflow:visible}
.chalkdeco path{fill:none;stroke:var(--acc);stroke-linecap:round;stroke-linejoin:round}
main h3>.chalkdeco.ul{left:-4px;bottom:-4px;width:calc(100% + 12px);height:12px}
main p>strong.step>.chalkdeco.box{left:-3px;top:-4px;width:calc(100% + 6px);height:calc(100% + 8px)}
html.slate .chalkdeco{-webkit-mask:var(--chalkmask) 0 0/128px 128px repeat;mask:var(--chalkmask) 0 0/128px 128px repeat}
/* the chalk stick that follows the pen */
#nub{transition:left .09s linear,top .09s linear,opacity .4s}
/* ---------- brainstorm: notes on the board while the lesson is researched; erased with a felt eraser ---------- */
#brainstorm{position:relative;margin:30px 0 70px;min-height:160px}
#brainstorm .bl{position:relative;width:max-content;max-width:100%;margin:4px 0 8px;font:30px/1.3 'Patrick Hand',cursive;color:#ecebe3;transform:rotate(var(--tilt,0deg))}
#brainstorm .bl.head{color:color-mix(in srgb,var(--acc) 65%,#ecebe3)}
#brainstorm .bl.sub{margin-left:34px;font-size:26px}
#brainstorm .smudge{position:absolute;margin:0;filter:blur(4px);opacity:.2;transition:opacity 1.6s ease-out;pointer-events:none}
.eraser{position:absolute;left:0;top:0;width:78px;height:36px;border-radius:6px;pointer-events:none;z-index:5;
  background:linear-gradient(#4a4036 0 58%,#b9ad97 58% 100%);box-shadow:0 3px 8px #000b,inset 0 1px 0 #ffffff22}
/* ### subtitles: underlined with a hand-drawn chalk stroke in the lesson's accent, so they read as sub-steps of the ## above */
main h3{display:table;position:relative;padding-bottom:9px}
/* one control, top right: the ring is the lesson's XP and the button that opens Contents */
#tocbtn{position:fixed;top:14px;right:14px;z-index:1004;width:42px;height:42px;border-radius:50%;border:0;background:#0f0f0f;color:var(--chalk);display:none;place-items:center;cursor:pointer;padding:0;box-shadow:0 0 0 1px var(--rule)}
#tocbtn.show{display:grid}
#tocbtn:hover,#tocbtn[aria-expanded="true"]{box-shadow:0 0 0 1px var(--dim)}
#tocbtn .ring{position:absolute;inset:3px;width:36px;height:36px;transform:rotate(-90deg)}
#tocbtn .ring circle{fill:none;stroke-width:3}
#tocbtn .ring .trk{stroke:#262626}
#tocbtn .ring .arc{stroke:var(--acc);stroke-linecap:round;stroke-dasharray:100.53;stroke-dashoffset:100.53;transition:stroke-dashoffset .6s cubic-bezier(.2,.8,.2,1),stroke .3s;filter:drop-shadow(0 0 3px color-mix(in srgb,var(--acc) 70%,transparent))}
#tocbtn.full .ring .arc{stroke:#d9b44a;filter:drop-shadow(0 0 4px #d9b44a)}
#tocbtn .rl{position:relative;font:600 12px/1 var(--body);letter-spacing:.02em;font-variant-numeric:lining-nums tabular-nums}
#tocbtn .ico{position:relative;width:16px;height:16px;color:var(--dim)}
#tocbtn .dot{position:absolute;top:2px;left:2px;width:9px;height:9px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 2px #0c0c0c,0 0 6px var(--acc)}
/* Contents as a level map: a card that drops from under the XP button on the left, so it lives beside the docked chat */
#tocshade{position:fixed;top:0;left:0;bottom:0;right:var(--chatw,0px);background:#0007;z-index:1002;opacity:0;pointer-events:none;transition:opacity .2s}
#tocshade.open{opacity:1;pointer-events:auto}
#toc{position:fixed;top:var(--tocy,64px);left:var(--tocx,14px);width:min(400px,calc(100vw - 16px));max-height:calc(100vh - var(--tocy,64px) - 14px);z-index:1003;display:flex;flex-direction:column;background:#0e0e0d;border:1px solid #2a2a27;border-radius:12px;box-shadow:0 22px 60px #000d,0 0 0 1px #00000080;transform:translateX(-18px);opacity:0;visibility:hidden;transition:transform .22s cubic-bezier(.2,.8,.2,1),opacity .18s,visibility 0s linear .22s}
#toc.open{transform:none;opacity:1;visibility:visible;transition:transform .22s cubic-bezier(.2,.8,.2,1),opacity .18s}
html.chatopen #toc{right:auto}
#toc .tochead{display:flex;align-items:baseline;gap:10px;padding:16px 18px 12px;border-bottom:1px solid var(--rule)}
#toc .tochead b{font:500 20px var(--display);color:var(--chalk)}
#toc .tochead kbd{font:12px var(--body);color:var(--dim);border:1px solid var(--rule);border-radius:4px;padding:0 6px}
#toc .tochead .xpsum{margin-left:auto;font:9px/1 'Press Start 2P',monospace;letter-spacing:.04em;color:var(--dim);white-space:nowrap}
#toc .tochead .xpsum b{font:inherit;color:#d9b44a}
#toc ol{list-style:none;margin:0;padding:0}
#toc>ol{position:relative;overflow-y:auto;flex:1;padding:14px 10px 18px 0;--path0:0px;--path1:0px;--pathfill:0px;scrollbar-width:thin;scrollbar-color:#2a2a2a transparent}
/* the path: a dashed chalk track through every node, filled solid in the accent up to the reading position */
#toc>ol::before,#toc>ol::after{content:'';position:absolute;left:33px;width:4px;margin-left:-2px;top:var(--path0);pointer-events:none}
#toc>ol::before{height:calc(var(--path1) - var(--path0));background:repeating-linear-gradient(#3a3a36 0 6px,transparent 6px 10px)}
#toc>ol::after{height:max(0px,calc(var(--pathfill) - var(--path0)));background:var(--acc);box-shadow:0 0 8px color-mix(in srgb,var(--acc) 55%,transparent)}
#toc li.lv{position:relative;z-index:1}
#toc li.lv>a{display:flex;align-items:center;gap:14px;padding:8px 12px 8px 20px;color:var(--dim);text-decoration:none;border-radius:0 8px 8px 0}
#toc li.lv>a:hover{background:#171715;color:var(--chalk)}
#toc li.lv>a:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
/* nodes: square 8-bit tiles. Cleared = filled accent, current = chalk with a pulsing glow, not started = dim outline */
#toc .node{flex:0 0 26px;width:26px;height:26px;display:grid;place-items:center;border:2px solid #4a4a45;background:#0e0e0d;color:#77776f;font:8px/1 'Press Start 2P',monospace;box-shadow:inset -2px -2px 0 #00000055;image-rendering:pixelated}
#toc .node svg{width:12px;height:12px;shape-rendering:crispEdges}
#toc li.clr>a>.node{background:var(--acc);border-color:color-mix(in srgb,var(--acc) 60%,var(--chalk));color:var(--chalk);box-shadow:inset -2px -2px 0 #00000040,inset 2px 2px 0 #ffffff26}
#toc li.cur>a>.node{background:var(--chalk);border-color:#fff;color:#0c0c0c;animation:nodeglow 1.2s steps(2) infinite}
@keyframes nodeglow{0%{box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 55%,transparent),0 0 14px var(--acc)}50%{box-shadow:0 0 0 1px color-mix(in srgb,var(--acc) 40%,transparent),0 0 6px color-mix(in srgb,var(--acc) 60%,transparent)}}
#toc .lvtxt{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px}
#toc .lvk{font:600 11px/1.2 var(--body);letter-spacing:.12em;text-transform:uppercase;color:#77776f}
#toc .lvn{font:17px/1.25 var(--body);color:inherit}
#toc .lvn .katex{font-size:1em}
#toc li.clr>a,#toc li.cur>a{color:var(--chalk)}
#toc li.cur>a{background:linear-gradient(90deg,color-mix(in srgb,var(--acc) 16%,transparent),transparent 85%)}
#toc li.cur .lvk{color:color-mix(in srgb,var(--acc) 55%,var(--chalk))}
#toc .lvmeta{display:flex;align-items:center;gap:8px;min-height:0}
#toc .lvmeta:empty{display:none}
#toc .stars{font-size:13px;letter-spacing:1px;line-height:1.2;color:#4a4a45}
#toc .stars i{font-style:normal}#toc .stars i.on{color:#d9b44a;text-shadow:0 0 6px #d9b44a77}
#toc .here,#toc .lvtag{font:7px/1 'Press Start 2P',monospace;letter-spacing:.06em;text-transform:uppercase;padding:3px 5px 2px;border:1px solid currentColor;border-radius:2px}
#toc .here{color:var(--chalk);background:color-mix(in srgb,var(--acc) 35%,transparent);border-color:color-mix(in srgb,var(--acc) 70%,var(--chalk))}
#toc .lvtag.boss{color:#d9845a}#toc .lvtag.save{color:#7fb6a0}
/* boss level and save point: same path, their own tile */
#toc li.boss>a>.node{width:30px;height:30px;flex-basis:30px;margin:0 -2px;border-color:#a0573a;color:#d9845a}
#toc li.boss.clr>a>.node{background:#a0573a;color:#1a0f0a}
#toc li.save>a>.node{border-color:#4f8a74;color:#7fb6a0;border-radius:50%}
#toc li.save.clr>a>.node{background:#4f8a74;color:#0c1a14}
#toc li.quiz>a>.node{border-color:#8d7a3a;color:#d9b44a}
#toc li.quiz.clr>a>.node{background:#8d7a3a;color:#1a140a}
/* the current chapter's sections: small sub-nodes on the same path */
#toc .subs{padding:0 0 6px}
#toc .sub>a{display:flex;align-items:center;gap:14px;padding:4px 12px 4px 29px;color:var(--dim);text-decoration:none;font:15px/1.3 var(--body);border-radius:0 6px 6px 0}
#toc .sub>a:hover{color:var(--chalk);background:#171715}
#toc .sub>a:focus-visible{outline:2px solid var(--acc);outline-offset:-2px}
#toc .sn{flex:0 0 8px;width:8px;height:8px;border:1.5px solid #5a5a54;background:#0e0e0d;position:relative;z-index:1}
#toc .sub.clr .sn{background:var(--acc);border-color:var(--acc)}
#toc .sub.cur .sn{background:var(--chalk);border-color:var(--chalk);box-shadow:0 0 6px var(--acc)}
#toc .sub.cur>a{color:var(--chalk)}
#toc .sl{flex:1;min-width:0}#toc .sl .katex{font-size:1em}
#toc .new{flex:0 0 7px;width:7px;height:7px;border-radius:50%;background:var(--acc);box-shadow:0 0 6px var(--acc)}
@media (prefers-reduced-motion:reduce){#toc li.cur>a>.node{animation:none;box-shadow:0 0 0 2px color-mix(in srgb,var(--acc) 55%,transparent),0 0 10px var(--acc)}}
@media (prefers-reduced-motion:reduce){#toc,#tocshade{transition:none}}
/* right-answer celebration: gold pixel burst, floating +1 XP, ring pulse; a bigger one when the quiz is cleared */
#fx{position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:1006;image-rendering:pixelated}
.xpfloat{position:fixed;z-index:1007;pointer-events:none;font:12px/1 'Press Start 2P',monospace;color:#d9b44a;text-shadow:2px 2px 0 #3a2e10,0 0 8px #d9b44a88;animation:xprise 1s steps(14) forwards;white-space:nowrap}
.xpfloat.combo{color:#e9e6df;font-size:10px;text-shadow:2px 2px 0 #3a2e10}
@keyframes xprise{0%{transform:translate(-50%,0);opacity:0}12%{opacity:1}75%{opacity:1}100%{transform:translate(-50%,-54px);opacity:0}}
.mcqi label.right.win{animation:winflash .7s steps(6)}
@keyframes winflash{0%,34%,68%{background:#d9b44a2e;box-shadow:inset 0 0 0 2px #d9b44a}17%,51%,100%{background:transparent;box-shadow:none}}
#tocbtn.bump{animation:hpbump .45s steps(6)}
@keyframes hpbump{0%,100%{box-shadow:0 0 0 1px var(--rule)}30%,70%{box-shadow:0 0 0 2px var(--acc),0 0 14px color-mix(in srgb,var(--acc) 60%,transparent)}}
/* XP as a health bar: the Contents button fills the top-right space between the search box and the edge */
#tocbtn{--sw:min(460px,calc(100vw - 420px));width:calc((100vw - var(--sw))/2 - 26px);border-radius:21px;padding:0 14px 0 13px;gap:11px;justify-content:stretch}
#tocbtn.show{display:flex;align-items:center}
#tocbtn .ring{display:none}
#tocbtn .ico{flex:0 0 16px}
#tocbtn .hplbl{flex:0 0 auto;font:10px/1 'Press Start 2P',monospace;color:var(--acc);letter-spacing:.04em}
#tocbtn .hp{flex:1;min-width:24px;height:14px;display:flex;gap:2px;padding:2px;box-sizing:border-box;border:1px solid color-mix(in srgb,var(--acc) 45%,#2a2a2a);border-radius:3px;background:#0a0a0a}
#tocbtn .hp i{flex:1;border-radius:1px;background:color-mix(in srgb,var(--acc) 14%,#151515);transition:background .35s,box-shadow .35s}
#tocbtn .hp i.on{background:var(--acc);box-shadow:0 0 6px color-mix(in srgb,var(--acc) 60%,transparent)}
#tocbtn.full .hp i.on{background:#d9b44a;box-shadow:0 0 6px #d9b44a99}
#tocbtn.full .hplbl{color:#d9b44a}
#tocbtn .rl{flex:0 0 auto;font:600 14px/1 var(--body);color:var(--chalk)}
#tocbtn .dot{top:-2px;left:auto;right:-2px}
@media (max-width:760px){#tocbtn{width:150px}#topbar{padding-right:178px}#tocbtn .hplbl{display:none}}

@keyframes bump{0%{transform:scale(1)}40%{transform:scale(1.28)}100%{transform:scale(1)}}
#cleared{position:fixed;left:50%;top:38%;z-index:1007;pointer-events:none;transform:translate(-50%,-50%);text-align:center;font:18px/1.6 'Press Start 2P',monospace;color:#d9b44a;text-shadow:3px 3px 0 #3a2e10,0 0 18px #d9b44a99;animation:cleared 2.4s steps(24) forwards}
#cleared small{display:block;font-size:10px;color:#e9e6df;margin-top:10px;letter-spacing:.08em}
@keyframes cleared{0%{opacity:0;transform:translate(-50%,-50%) scale(.6)}10%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}18%{transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0}}
/* the celebration is short and was asked for, so it plays even with Reduce Motion on */
/* zoom: scales the lesson column and the chat's messages and composer; fixed controls keep their size. Remembered per browser. */
main,#chatlist,#chatform{zoom:var(--z,1)}
/* top bar: one row of 42px controls on a shared centre line; search is centred on the viewport */
#topbar{position:fixed;top:0;left:0;right:0;height:70px;z-index:1003;display:none;align-items:center;gap:8px;padding:0 14px;background:linear-gradient(#0c0c0c 60%,#0c0c0c00);pointer-events:none;--tb:42px}
html.railmode #topbar{display:flex}
#topbar>*{pointer-events:auto}
#toplessons,#zoomctl,#topsearch input{height:var(--tb);box-sizing:border-box;background:#0f0f0f;box-shadow:0 0 0 1px var(--rule);border:0}
#toplessons{width:var(--tb);flex:0 0 var(--tb);display:grid;place-items:center;border-radius:50%;color:var(--dim);text-decoration:none}
#toplessons svg{width:18px;height:18px}
#toplessons:hover,#toplessons:focus-visible,#zoomctl button:focus-visible{color:var(--chalk);box-shadow:0 0 0 1px var(--dim);outline:none}
#zoomctl{display:flex;align-items:center;gap:0;border-radius:calc(var(--tb)/2);padding:0 4px}
#zoomctl button{width:32px;height:32px;border:0;border-radius:50%;background:none;color:var(--dim);font:20px/1 var(--body);cursor:pointer;padding:0;display:grid;place-items:center}
#zoomctl button:hover{color:var(--chalk);background:#1a1a1a}
#zoomctl button:disabled{opacity:.3;cursor:default;background:none}
#zoomctl .zv{width:auto;min-width:46px;padding:0 4px;border-radius:12px;font:13px var(--body);font-variant-numeric:lining-nums tabular-nums;letter-spacing:.02em}
#topsearch{position:absolute;left:50%;top:14px;transform:translateX(-50%);width:min(460px,calc(100vw - 420px))}
#topsearch input{width:100%;border-radius:calc(var(--tb)/2);color:var(--chalk);font:16px var(--body);padding:0 44px 0 42px;outline:none;-webkit-appearance:none;appearance:none}
#topsearch input::-webkit-search-cancel-button{display:none}
#topsearch input::placeholder{color:var(--dim)}
#topsearch input:focus{box-shadow:0 0 0 1px color-mix(in srgb,var(--acc) 70%,var(--dim))}
#topsearch svg{position:absolute;left:16px;top:13px;width:16px;height:16px;color:var(--dim);pointer-events:none}
#topsearch kbd{position:absolute;right:14px;top:11px;height:20px;line-height:18px;box-sizing:border-box;font:12px var(--body);color:var(--dim);border:1px solid var(--rule);border-radius:5px;padding:0 6px}
#topsearch input:focus~kbd,#topsearch input:not(:placeholder-shown)~kbd{display:none}
#topresults{position:absolute;top:50px;left:0;right:0;max-height:min(60vh,440px);overflow:auto;background:#0f0f0f;border:1px solid var(--rule);border-radius:10px;box-shadow:0 14px 40px #000c;padding:6px;display:none}
#topresults.open{display:block}
#topresults a{display:block;padding:8px 12px;border-radius:6px;color:var(--chalk);text-decoration:none;font:17px/1.3 var(--body)}
#topresults a span{display:block;font-size:14px;color:var(--dim)}
#topresults a.sel,#topresults a:hover{background:#1a1a1a}
#topresults a.sel{box-shadow:inset 3px 0 0 var(--acc)}
#topresults a em{display:block;font-style:normal;font-size:14.5px;line-height:1.4;color:#b9b5aa;margin-top:3px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
#topresults mark{background:color-mix(in srgb,var(--acc) 45%,transparent);color:var(--chalk);border-radius:2px;padding:0 1px}
#topresults .none{padding:10px 12px;color:var(--dim);font:16px var(--body)}
html.railmode main{padding-top:84px}
@media (max-width:760px){#zoomctl .zv{display:none}#topsearch{position:static;transform:none;flex:1;width:auto;min-width:0}#topbar{padding-right:68px}}
#zoomctl button{width:34px;height:34px;border:0;border-radius:50%;background:none;color:var(--dim);font:22px/1 var(--body);cursor:pointer;padding:0}
#zoomctl button:hover,#zoomctl button:focus-visible{color:var(--chalk);background:#161616;outline:none}
#zoomctl button:disabled{opacity:.3;cursor:default;background:none}
#zoomctl .zv{min-width:44px;font:14px var(--body);font-variant-numeric:lining-nums tabular-nums;border-radius:12px}
/* ---------- top bar: one row across the whole width, scaling with the window:
   [back][zoom]  [search, takes what is left]  [XP, a fixed share of the width] ---------- */
:root{--xpw:clamp(160px,25vw,440px)}
#topbar{gap:10px !important;padding:0 calc(28px + var(--xpw)) 0 14px !important}
#topsearch{position:relative !important;top:auto !important;left:auto !important;transform:none !important;flex:1 1 auto;width:auto !important;min-width:0;max-width:none}
#tocbtn{width:var(--xpw) !important}
@media (max-width:760px){:root{--xpw:124px}#topbar{padding-right:calc(22px + var(--xpw))}#tocbtn{width:var(--xpw) !important}}
/* ---------- study chat: docked on the right, pushes the lesson column left (not an overlay) ---------- */
:root{--chatpw:380px;--chatw:0px}
html.chatopen{--chatw:var(--chatpw);--xpw:clamp(140px,calc((100vw - var(--chatpw))*.25),440px)}
html.chatopen body{margin-right:var(--chatw)}
/* with the chat docked, the column keeps a real side margin in the space that is left instead of running edge to edge */
html.chatopen main{max-width:min(860px,calc((100vw - var(--chatw) - 120px) / var(--z,1)))}
html.chatopen #topbar{right:var(--chatw)}
html.chatopen #tocbtn{right:calc(14px + var(--chatw))}
html.chatopen .rail{right:calc(6px + var(--chatw))}
#chatbtn{position:fixed;top:14px;right:calc(14px + var(--chatw));z-index:1004;width:42px;height:42px;border:0;border-radius:50%;background:#0f0f0f;box-shadow:0 0 0 1px var(--rule);color:var(--dim);display:grid;place-items:center;cursor:pointer;padding:0}
html.railmode #chatbtn{right:calc(14px + var(--chatw))}
#topbar #tocbtn{position:relative;top:auto;right:auto !important;flex:0 0 var(--xpw);z-index:auto}
html.railmode #topbar{padding-right:70px !important}
#chatbtn[hidden]{display:none}
#chatbtn svg{width:18px;height:18px}
#chatbtn:hover,#chatbtn:focus-visible{color:var(--chalk);box-shadow:0 0 0 1px var(--dim);outline:none}
#chatbtn[aria-expanded="true"]{color:var(--chalk);box-shadow:0 0 0 1px color-mix(in srgb,var(--acc) 70%,var(--dim))}
#chat{position:fixed;top:0;right:0;bottom:0;width:var(--chatpw);z-index:1006;display:none;flex-direction:column;background:#0f0f0f;border-left:1px solid var(--rule);color:var(--chalk);font-family:var(--body)}
html.chatopen #chat{display:flex}
#chat .chead{flex:0 0 64px;display:flex;align-items:center;gap:4px;padding:0 12px 0 20px;border-bottom:1px solid var(--rule)}
#chat .ct{flex:1;min-width:0;font:500 18px/1 var(--display);letter-spacing:.01em}
#chat .cib{flex:0 0 auto;width:32px;height:32px;border:0;border-radius:50%;background:none;color:var(--dim);display:grid;place-items:center;cursor:pointer;padding:0}
#chat .cib svg{width:16px;height:16px}
#chat .cib:hover,#chat .cib:focus-visible{background:#1a1a1a;color:var(--chalk);outline:none}
#chat .cib:disabled{opacity:.3;cursor:default;background:none}
#chat .cmid{flex:1;min-height:0;position:relative}
#chatlist{position:absolute;inset:0;overflow-y:auto;padding:22px 20px 12px;scrollbar-width:thin;scrollbar-color:#2a2a2a transparent}
#chatdown{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);width:32px;height:32px;border-radius:50%;border:1px solid #2c2c2c;background:#161616;color:var(--chalk);display:grid;place-items:center;cursor:pointer;box-shadow:0 6px 18px #000a;padding:0}
#chatdown[hidden]{display:none}
#chatdown svg{width:15px;height:15px}
#chat .cmsg{margin:0 0 22px}
#chat .cmsg.user{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
#chat .cmsg.user .cb{max-width:86%;background:#1a1a1a;border:1px solid #262626;border-radius:16px 16px 4px 16px;padding:8px 14px;font-size:16.5px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}
#chat .cq{max-width:86%;border-left:2px solid var(--acc);padding:2px 0 2px 10px;font-size:14.5px;line-height:1.45;color:#b9b5aa;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
#chat .cq p{margin:0;max-width:none}
#chat .cmsg.bot{font-size:17px;line-height:1.55;overflow-wrap:anywhere}
#chat .cmd>:first-child{margin-top:0}
#chat .cmd>:last-child{margin-bottom:0}
#chat .cmd p,#chat .cmd ul,#chat .cmd ol{margin:0 0 10px;max-width:none}
#chat .cmd ul,#chat .cmd ol{padding-left:22px}
#chat .cmd li{margin:3px 0}
#chat .cmd h1,#chat .cmd h2,#chat .cmd h3,#chat .cmd h4{font:600 17px/1.3 var(--body);margin:16px 0 6px}
#chat .cmd blockquote{margin:8px 0 10px;padding:2px 0 2px 12px;border-left:2px solid var(--acc);color:#cfcabd}
#chat .cmd blockquote p{margin:0 0 6px}
#chat .cmd a{color:color-mix(in srgb,var(--acc) 55%,var(--chalk));text-underline-offset:3px}
#chat .cmd code{font:13.5px/1.4 ui-monospace,Menlo,monospace;background:#1a1a1a;border-radius:4px;padding:1px 5px}
#chat .cmd pre{background:#141414;border:1px solid var(--rule);border-radius:8px;padding:10px 12px;margin:8px 0 12px;overflow-x:auto;scrollbar-width:thin;scrollbar-color:#2a2a2a transparent}
#chat .cmd pre code{background:none;padding:0}
#chat .cmd .katex{font-size:1.04em}
#chat .cmd .mathrow{padding:6px 2px;margin:6px 0}
#chat .cmd .tablewrap{margin:10px 0 12px}
#chat .cmd .tablewrap th{font-size:12.5px;padding:8px 16px 6px 0}
#chat .cmd .tablewrap td{padding:7px 16px 7px 0;font-size:15.5px}
#chat .cmd hr{border:0;border-top:1px solid var(--rule);margin:14px 0}
#chat .csteps{margin:0 0 8px;font-size:14.5px;line-height:1.4;color:var(--dim)}
#chat .cs{display:flex;gap:9px;align-items:baseline;padding:2px 0;overflow-wrap:anywhere}
#chat .cs::before{content:'';flex:0 0 6px;height:6px;border-radius:50%;background:#3b3b3b;transform:translateY(-1px)}
#chat .cs.live::before{background:var(--acc);animation:cpulse 1.1s ease-in-out infinite}
#chat .cstog{display:flex;align-items:center;gap:6px;background:none;border:0;padding:2px 0;color:var(--dim);font:14.5px var(--body);cursor:pointer}
#chat .cstog:hover{color:var(--chalk)}
#chat .cstog::before{content:'▸';font-size:11px}
#chat .csteps.open .cstog::before{content:'▾'}
#chat .csteps.done:not(.open) .cs{display:none}
#chat .cthink{display:flex;align-items:center;gap:9px;color:var(--dim);font-size:15px}
#chat .cthink::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--acc);animation:cpulse 1.1s ease-in-out infinite}
#chat .ccopy{margin-top:6px;width:26px;height:26px}
#chat .ccopy svg{width:14px;height:14px}
#chat .cerr{color:#e3b2a2;font-size:15px;margin:0 0 16px}
@keyframes cpulse{0%,100%{opacity:.35}50%{opacity:1}}
#chat .cempty{padding:36px 4px 0;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
#chat .cempty .cmark{width:52px;height:52px;border-radius:50%;border:1px solid #2c2c2c;display:grid;place-items:center;color:var(--dim);margin-bottom:10px}
#chat .cempty .cmark svg{width:22px;height:22px}
#chat .cempty h2{font:500 20px/1.3 var(--display);margin:0}
#chat .cempty p{margin:0 0 18px;color:var(--dim);font-size:15px;max-width:none}
#chat .cchip{display:block;width:100%;text-align:left;background:none;border:0;border-radius:10px;padding:9px 12px;color:#cfcabd;font:16px/1.35 var(--body);cursor:pointer}
#chat .cchip:hover,#chat .cchip:focus-visible{background:#181818;color:var(--chalk);outline:none}
#chatform{flex:0 0 auto;margin:4px 12px 14px;background:#141414;border:1px solid #2a2a2a;border-radius:14px;padding:10px 10px 8px 14px}
#chatform:focus-within{border-color:#3d3d3d}
#chatsel{display:flex;gap:6px;align-items:flex-start;margin:0 0 8px;padding:5px 4px 5px 10px;border-left:2px solid var(--acc);background:#1a1a1a;border-radius:0 6px 6px 0}
#chatsel[hidden]{display:none}
#chatsel .cselt{flex:1;min-width:0;font-size:14px;line-height:1.4;color:#cfcabd;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
#chatsel .cib{width:24px;height:24px}
#chatsel .cselt p{margin:0;max-width:none}#chatsel .cselt .katex{font-size:1em}
#chatq{display:block;width:100%;resize:none;border:0;outline:0;background:none;color:var(--chalk);font:16.5px/1.45 var(--body);max-height:200px;min-height:24px;padding:2px 0;margin:0}
#chatq::placeholder{color:var(--dim)}
#chat .cbar{display:flex;align-items:center;gap:8px;margin-top:8px}
#chat .cctx{flex:1;min-width:0;display:flex;align-items:center;gap:6px;font-size:13px;color:var(--dim);white-space:nowrap}
#chat .cctx svg{flex:0 0 13px;width:13px;height:13px}
#chat .cctx span{overflow:hidden;text-overflow:ellipsis}
#chatsend{flex:0 0 32px;width:32px;height:32px;border:0;border-radius:50%;background:var(--chalk);color:#0c0c0c;display:grid;place-items:center;cursor:pointer;padding:0}
#chatsend svg{width:15px;height:15px}
#chatsend:disabled{opacity:.25;cursor:default}
#chatgrip{position:absolute;top:0;bottom:0;left:-5px;width:10px;cursor:col-resize;z-index:2;touch-action:none}
#chatgrip::after{content:"";position:absolute;top:0;bottom:0;left:4px;width:2px;background:transparent;transition:background .15s}
#chatgrip:hover::after,html.chatdrag #chatgrip::after{background:var(--rule)}
html.chatdrag,html.chatdrag *{user-select:none !important;cursor:col-resize !important}
@media (max-width:760px){html.chatopen{--chatw:0px}#chat{width:100vw}#chatgrip{display:none}}
@media (prefers-reduced-motion:reduce){#chat .cs.live::before,#chat .cthink::before{animation:none;opacity:1}}
/* source viewer: a cited file fills the lesson column, the chat stays open on the right */
details.sources .srcfiles{margin-top:12px}
details.sources .srcfiles h4{margin:10px 0 4px;font:600 13px var(--body);letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
details.sources .srcfiles .sfrow{display:flex;flex-wrap:wrap;gap:6px 8px;margin:0 0 6px}
a.srclink{color:var(--acc);text-decoration:none;border-bottom:1px dashed color-mix(in srgb,var(--acc) 55%,transparent);cursor:pointer}
a.srclink:hover,a.srclink:focus-visible{border-bottom-style:solid}
details.sources .srcfiles a.srclink{font:13px/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;padding:3px 8px;border:1px solid var(--rule);border-radius:6px;background:#ffffff08}
details.sources .srcfiles a.srclink:hover{border-color:var(--acc)}
details.sources .srcfiles .sfmiss{font:13px ui-monospace,Menlo,monospace;color:var(--dim);opacity:.7}
#srcview{position:fixed;top:0;left:0;bottom:0;right:var(--chatw,0px);z-index:1005;display:none;flex-direction:column;background:#111}
html.srcopen #srcview{display:flex}
html.srcopen body{overflow:hidden}
#srcview .svbar{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--rule);background:#0f0f0f;color:var(--chalk);font-family:var(--body)}
#srcview .svname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:14px ui-monospace,Menlo,monospace}
#srcview .svname small{color:var(--dim);margin-left:8px}
#srcview .svbar a,#srcview .svbar button{font:13px var(--body);color:var(--chalk);background:#ffffff0d;border:1px solid var(--rule);border-radius:8px;padding:6px 12px;cursor:pointer;text-decoration:none;white-space:nowrap}
#srcview .svbar button.svback{background:var(--acc);color:#111;border-color:var(--acc);font-weight:600}
#srcview .svbody{flex:1;min-height:0;overflow:auto}
#srcview iframe{width:100%;height:100%;border:0;display:block;background:#525659}
#srcview img{display:block;width:100%;height:auto}
#srcview pre{margin:0;padding:24px 28px;white-space:pre-wrap;word-break:break-word;font:14px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--chalk)}
#srcview .svmd{padding:24px 32px;max-width:860px;color:var(--chalk)}
#srcview .svmiss{padding:40px;color:var(--dim);font-family:var(--body)}
</style>
