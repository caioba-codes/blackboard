// ---------- step-by-step reveal ----------
// A solution the student works out themselves (a check-in answer, multiple-choice feedback with worked steps) opens one
// step at a time: the lead sentence and the first piece (the boxed setup, else row 1 of the first derivation with its
// margin note), then "Next step" adds one aligned row with its note, and the last press shows the boxed answer.
// Taught worked examples are never stepped. Generic: it reads the rendered answer, no extra markup. Print shows all.
const RV=new Set();
// items: [{kind:'prose'|'math'|'rows', n}] in order -> {lead:[entries], steps:[[entries]]}; an entry is {i,row}.
// Prose before the first math is the lead (always shown); prose between math joins the next step; trailing prose the last.
function stepPlan(items){
  const lead=[], steps=[]; let pend=[], seen=false;
  items.forEach((it,i)=>{
    if(it.kind==='prose'){ (seen?pend:lead).push({i,row:null}); return; }
    seen=true;
    const n=it.kind==='rows'?Math.max(1,it.n|0):1;
    for(let r=0;r<n;r++){ steps.push(pend.concat([{i,row:it.kind==='rows'?r:null}])); pend=[]; }
  });
  if(pend.length){ if(steps.length)steps[steps.length-1].push(...pend); else lead.push(...pend); }
  return {lead,steps};
}
// rows of one aligned display, grouped by source line: a KaTeX row holding only a margin note (stacked under its step
// on a narrow column) belongs to the step above it
function rvGroups(mr){
  const cells=mathCells(mr); if(!cells||!cells.length)return null;
  const by=new Map(); cells.forEach(c=>{ if(!by.has(c.row))by.set(c.row,[]); by.get(c.row).push(c); });
  const groups=[]; [...by.keys()].sort((a,b)=>a-b).forEach(r=>{ const cs=by.get(r); if(groups.length&&cs.every(c=>c.note))groups[groups.length-1].push(...cs); else groups.push(cs.slice()); });
  return groups;
}
function rvFade(el){ el.classList.remove('rv-in'); void el.offsetWidth; el.classList.add('rv-in'); el.addEventListener('animationend',()=>el.classList.remove('rv-in'),{once:true}); }
// show rows 0..max of an aligned display, clip the box under the last one
function rvRows(mr,max,anim){
  if(max<0)return;
  const groups=rvGroups(mr); if(!groups)return;
  const was=mr.dataset.rvmax===undefined?-1:+mr.dataset.rvmax;
  groups.forEach((g,gi)=>g.forEach(c=>c.hosts.forEach(h=>{ h.style.visibility=gi<=max?'':'hidden'; if(anim&&gi<=max&&gi>was)rvFade(h); })));
  mr.dataset.rvmax=String(max);
  const all=max>=groups.length-1;
  const r=mr.getBoundingClientRect(), sc=mr.offsetHeight/(r.height||1);
  const bottom=Math.max(...groups[Math.min(max,groups.length-1)].map(c=>c.bottom));
  mr.classList.add('rv-clip');
  const h=Math.ceil((bottom-r.top)*sc+14);
  if(all){ if(anim&&mr.style.height){ mr.style.height=Math.ceil(mr.scrollHeight)+'px'; setTimeout(()=>{ if(mr.dataset.rvmax===String(max))mr.style.height=''; },340); } else mr.style.height=''; }
  else mr.style.height=h+'px';
}
function rvApply(box,anim){
  const st=box._rv; if(!st)return;
  const vis=new Map(), mark=e=>{ const v=vis.get(e.i); vis.set(e.i,e.row==null?Infinity:Math.max(v===undefined?-1:v,e.row)); };
  st.plan.lead.forEach(mark); st.plan.steps.slice(0,st.k).forEach(s=>s.forEach(mark));
  st.items.forEach((it,i)=>{
    const v=vis.get(i), on=v!==undefined, was=!it.el.classList.contains('rv-off');
    it.el.classList.toggle('rv-off',!on);
    if(it.kind==='rows'){ if(!on)delete it.el.dataset.rvmax; else rvRows(it.el,v===Infinity?1e9:v,anim); }
    else if(on&&!was&&anim)rvFade(it.el);
  });
  rvCtl(box);
}
function rvGo(box,k){ const st=box._rv; if(!st)return; st.k=Math.max(0,Math.min(k,st.plan.steps.length)); rvApply(box,true); }
const RV_ARROW='<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v9M4 8.5 8 12.5l4-4"/></svg>';
function rvCtl(box){
  const st=box._rv, n=st.plan.steps.length; let c=st.ctl;
  if(st.k>=n){ if(c){ const had=c.contains(document.activeElement); c.remove(); st.ctl=null; if(had){ box.tabIndex=-1; box.focus({preventScroll:true}); } } return; }
  if(!c){
    c=st.ctl=document.createElement('div'); c.className='stepctl';
    c.innerHTML=`<button type="button" class="stepnext"><span class="stl">Next step</span><span class="stct"></span>${RV_ARROW}</button><button type="button" class="stepall">Show all</button><span class="srlive" aria-live="polite"></span>`;
    c.querySelector('.stepnext').onclick=e=>{ e.stopPropagation(); rvGo(box,st.k+1); };
    c.querySelector('.stepall').onclick=e=>{ e.stopPropagation(); rvGo(box,n); };
    box.appendChild(c);
  }
  c.querySelector('.stct').textContent=`${st.k+1} of ${n}`;
  c.querySelector('.stepnext').setAttribute('aria-label',`Next step, ${st.k+1} of ${n}`);
  c.querySelector('.srlive').textContent=st.k?`Step ${st.k} of ${n} shown`:'';
}
// start: how many steps show at once (1 for an opened answer, 0 after a wrong pick: verdict and hint first)
function rvSetup(box,start){
  if(!box||box._rv||!box.isConnected)return;
  const kids=[...box.children].filter(e=>!e.classList.contains('stepctl'));
  if(!kids.some(e=>e.classList.contains('mathrow')))return;   // one-line feedback with no derivation stays as it is
  const items=kids.map(el=>{
    if(!el.classList.contains('mathrow'))return {el,kind:'prose'};
    const tex=decodeURIComponent(el.dataset.tex||'');
    if(/^\s*\\boxed\s*\{/.test(tex)||!/\\begin\{(aligned|align\*?|alignedat)\}/.test(tex))return {el,kind:'math'};   // the boxed setup grid is one piece
    const g=rvGroups(el); return g&&g.length>1?{el,kind:'rows',n:g.length}:{el,kind:'math'};
  });
  const plan=stepPlan(items); if(plan.steps.length<2)return;
  box._rv={items,plan,k:Math.max(0,Math.min(start,plan.steps.length)),ctl:null}; box.classList.add('rv'); RV.add(box);
  rvApply(box,false);
}
// after a reflow or a math re-fit (which rebuilds the KaTeX inside a row), put every stepped answer back where it was
function rvReapply(){ RV.forEach(b=>{ if(!b.isConnected){RV.delete(b);return;} if(b.getClientRects().length)rvApply(b,false); }); }

// XP fills the top bar with verified answers only: a multiple-choice item answered right, or a flashcard graded 4 or 5. Scrolling adds nothing.
const xpArc=document.querySelector('#tocbtn .arc'), xpText=document.querySelector('#tocbtn .rl'), xpIco=document.querySelector('#tocbtn .ico'), xpSum=document.querySelector('#toc .xpsum');
function xpUpdate(){
  const ms=[...main.querySelectorAll('.mcqi')], cs=[...main.querySelectorAll('.fc[data-item]')], total=ms.length+cs.length;
  const got=ms.filter(m=>{const c=m.querySelector('input:checked');return m.classList.contains('done')&&c&&c.value===m.dataset.key}).length+cs.filter(c=>c.dataset.n!==''&&+c.dataset.n>=4).length;
  const full=total>0&&got===total;
  xpArc.style.strokeDashoffset=String(100.53*(1-(total?got/total:0)));
  document.getElementById('tocbtn').classList.toggle('full',full);
  xpText.hidden=!total; xpText.textContent=total?`${got}/${total}`:'';
  const hp=document.querySelector('#tocbtn .hp'), hpl=document.querySelector('#tocbtn .hplbl'); hp.hidden=hpl.hidden=!total;
  if(hp.children.length!==total)hp.innerHTML='<i></i>'.repeat(total);
  [...hp.children].forEach((c,i)=>c.classList.toggle('on',i<got));
  xpSum.innerHTML=total?`XP <b>${got}</b> / ${total}`:'';
  document.getElementById('tocbtn').title=total?`Contents (t) · XP ${got}/${total}: questions answered right`:'Contents (t)';
}
// a multiple-choice answer is marked the same way live and when restored from the log
function stemSig(it){ const t=(it.querySelector('.q')?.textContent||'').replace(/\s+/g,' ').trim(); let h=5381; for(let i=0;i<t.length;i++)h=((h<<5)+h+t.charCodeAt(i))|0; return (h>>>0).toString(36); }
function markMcq(it,choice,live){
  // answers stay changeable: a new pick replaces the old verdict; the key is shown only once it is picked
  const inp=it.querySelector(`input[value="${choice}"]`); if(!inp)return; inp.checked=true;
  if(it.classList.contains('done')&&it.dataset.choice===choice)return;
  it.dataset.choice=choice; it.classList.add('done'); const ok=choice===it.dataset.key;
  it.querySelectorAll('label').forEach(l=>l.classList.remove('right','wrong'));
  inp.closest('label').classList.add(ok?'right':'wrong');
  // right: the worked solution, stepped from its first piece. Wrong: the verdict and a one-line hint (the why's lead
  // sentence), then the same solution behind "Next step"; a why with no worked steps stays hidden until the right pick.
  const why=(it.dataset.why||'').replace(/\s*(\$\$[\s\S]+?\$\$)\s*/g,'\n\n$1\n\n'), worked=/\$\$/.test(why);   // each display on its own block, so the sentences around it stay paragraphs
  it.querySelector('.fb').innerHTML=ok?`<div class="fbc ok"><div class="fbh">✓ Correct</div>${why?`<div class="fbb">${md(why)}</div>`:''}</div>`:`<div class="fbc bad"><div class="fbh">✕ Not quite</div><div class="fbb">${inp.dataset.miss?`<p class="fbmiss">${mdInline(inp.dataset.miss)}</p>`:''}<p class="fbhint">Pick another option to try again${worked?', or step through the solution':''}.</p>${worked?md(why):''}</div></div>`;
  const fbb=it.querySelector('.fbb'); if(fbb&&worked){ fbb.querySelectorAll('.mathrow[data-tex]').forEach(fitMath); rvSetup(fbb,ok?1:0); }
  whyWire(it);
  const rb=it.querySelector('.mreset'); if(rb)rb.hidden=false;
  if(live)ask({kind:'mcq',item:it.dataset.item,choice,correct:ok,sig:stemSig(it)});
  tocSig=''; xpUpdate(); scheduleToc();
  if(live){ if(ok)celebrate(inp.closest('label'),document.getElementById('tocbtn').classList.contains('full')); else { FX.streak=0; sfx('wrong'); } }
}
// Reset clears an answered item back to unanswered (no verdict, no key, no XP) and logs a reset event,
// so a reload keeps it cleared; the earlier picks stay in the log as evidence. Quiet: no sound, no sparks.
function resetMcq(it){
  if(!it||!it.classList.contains('done'))return;
  it.classList.remove('done'); delete it.dataset.choice;
  it.querySelectorAll('input').forEach(i=>{i.checked=false;});
  it.querySelectorAll('label').forEach(l=>l.classList.remove('right','wrong','win'));
  it.querySelector('.fb').innerHTML=''; it.querySelector('.mreset').hidden=true;
  FX.streak=0;
  ask({kind:'mcq',event:'reset',item:it.dataset.item,sig:stemSig(it)});
  tocSig=''; xpUpdate(); scheduleToc();
  it.querySelector('input')?.focus({preventScroll:true});
}
// Right-answer celebration. Pixel sparks in the lesson's gold and green, a floating +1 XP, a short
// square-wave chime (press m to mute; remembered in this browser). Clearing every item gets a fanfare.
const FX={canvas:null,ctx:null,parts:[],raf:0,streak:0,audio:null,muted:false};
try{ FX.muted=localStorage.getItem('bb-sfx')==='off'; }catch(_){}
function fxCanvas(){
  if(FX.canvas)return; const c=document.createElement('canvas'); c.id='fx'; document.body.appendChild(c);
  FX.canvas=c; FX.ctx=c.getContext('2d');
  const fit=()=>{ c.width=Math.ceil(innerWidth/3); c.height=Math.ceil(innerHeight/3); FX.ctx.imageSmoothingEnabled=false; };
  fit(); addEventListener('resize',fit);
}
function fxBurst(x,y,n,spread){
  fxCanvas(); const cols=['#d9b44a','#c8bc83','#4ea672','#e9e6df','#9b3a4a'];
  for(let i=0;i<n;i++){ const a=Math.random()*Math.PI*2, v=(1.2+Math.random()*2.4)*spread;
    FX.parts.push({x:x/3,y:y/3,vx:Math.cos(a)*v,vy:Math.sin(a)*v-1.6*spread,life:34+Math.random()*26,c:cols[i%cols.length],s:Math.random()<.3?2:1}); }
  if(!FX.raf)FX.raf=requestAnimationFrame(fxTick);
}
function fxTick(){
  const g=FX.ctx; g.clearRect(0,0,FX.canvas.width,FX.canvas.height);
  FX.parts=FX.parts.filter(p=>p.life>0);
  for(const p of FX.parts){ p.x+=p.vx; p.y+=p.vy; p.vy+=.12; p.vx*=.97; p.life--;
    if(p.life%6<4||p.life>12){ g.fillStyle=p.c; g.fillRect(Math.round(p.x),Math.round(p.y),p.s+1,p.s+1); } }
  FX.raf=FX.parts.length?requestAnimationFrame(fxTick):0;
  if(!FX.raf)g.clearRect(0,0,FX.canvas.width,FX.canvas.height);
}
function fxChime(notes,step){
  if(FX.muted)return;
  try{ FX.audio=FX.audio||new (window.AudioContext||window.webkitAudioContext)(); const ac=FX.audio, t0=ac.currentTime+.01;
    notes.forEach((f,i)=>{ const o=ac.createOscillator(), g=ac.createGain(); o.type='square'; o.frequency.value=f;
      const t=t0+i*step; g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(.045,t+.005); g.gain.exponentialRampToValueAtTime(.0008,t+step*1.8);
      o.connect(g).connect(ac.destination); o.start(t); o.stop(t+step*2); });
  }catch(_){}
}
function fxFloat(text,x,y,cls){ const d=document.createElement('div'); d.className='xpfloat'+(cls?' '+cls:''); d.textContent=text; d.style.left=x+'px'; d.style.top=y+'px'; document.body.appendChild(d); setTimeout(()=>d.remove(),1100); }
function celebrate(label,cleared){
  FX.streak++;
