let fitT=0; function fitAllMath(){ clearTimeout(fitT); fitT=setTimeout(()=>{ main.querySelectorAll('.mathrow[data-tex]').forEach(fitMath); rvReapply(); whyWire(); },60); }
window.addEventListener('resize',fitAllMath);
if('ResizeObserver' in window) new ResizeObserver(fitAllMath).observe(document.body);
function marginNotes(t){ if(!/\\begin\{(aligned|align\*?|alignedat)\}/.test(t)) return t; let first=true;
  return t.replace(/&&((?:(?!\\\\|\\end\{).)+)/g,(m,note)=>{ if(!note.trim()) return m; const c=first?'mnote first':'mnote'; first=false; return `&&\\htmlClass{${c}}{${note}}`; }); }
