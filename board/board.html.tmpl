}
function applyBrainstorm(b){
  if(MODE!=='lesson'||!b||String(b.lesson)!==String(lessonId)||bodyStarted())return;
  const box=bsBox();
  if(!box.isConnected){ const hdr=main.querySelector('.top'); (hdr&&hdr.parentElement===main)?main.appendChild(box):main.appendChild(box); setWriting(false); }
  if((b.rev||0)<=(+box.dataset.rev||0))return; box.dataset.rev=b.rev||0;
  const want=(b.lines||[]).map(x=>String(x)).filter(x=>x.trim());
  if(!want.length&&fmCache&&fmCache.title) want.push('Explain: '+fmCache.title); // the board is never blank before the lesson starts
  const cur=[...box.querySelectorAll(':scope>.bl:not(.smudge)')].filter(x=>!x.dataset.gone);
  const old=cur.map(x=>x.dataset.t);
  // longest common subsequence: lines that stay in the same relative order are kept, the rest are erased/rewritten
