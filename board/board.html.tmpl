<script>
const MODE="__MODE__", LESSON_ARG="__LESSON__", WS="__WS__";
const WSB=WS?"/w/"+WS:"", WSQ=WS?"&ws="+WS:"";  // pages under /w/<slug>/ stay pinned to that workspace
const $=s=>document.querySelector(s);
const main=$('#main'), pill=$('#pill'), toast=$('#toast'), nub=$('#nub');
let lessonId=LESSON_ARG, offset=0, hash='', blocks=0, srcLines=[], streaming=false, expCount=0, nubTimer=null, state={};
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;

// Reading position only; never records lesson completion or mastery.
// The reading line runs from the top of the screen (page top) to its bottom (page end), so ticks can sit at each
// heading's true place in the document without piling up at the end, and the fill passes a tick as you reach it.
function readPos(){ const H=document.documentElement.scrollHeight, extent=H-window.innerHeight; if(extent<=0)return 1; const f=Math.max(0,Math.min(1,window.scrollY/extent)); return Math.min(1,(window.scrollY+window.innerHeight*f)/H); }
const readingProgress=$('#reading-progress');
let progressFrame=0;
function updateReadingProgress(){
  progressFrame=0;
  readingProgress.hidden=MODE==='grid'||!main.querySelector('#title');
  if(readingProgress.hidden)return;
  const ratio=readPos();
  readingProgress.style.setProperty('--pos',ratio.toFixed(4));
  readingProgress.setAttribute('aria-valuenow',String(Math.round(ratio*100)));
}
function scheduleReadingProgress(){
  if(!progressFrame)progressFrame=requestAnimationFrame(updateReadingProgress);
}
window.addEventListener('scroll',scheduleReadingProgress,{passive:true});
window.addEventListener('resize',scheduleReadingProgress);
new ResizeObserver(scheduleReadingProgress).observe(main);
scheduleReadingProgress();

// ---------- markdown -> html ----------
const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
// ---------- tap to see the rule: \why{math}{rule} (optionally \why[name]{math}{rule}) ----------
// The math renders as usual with a faint dotted underline; a tap opens the general rule that produced it. The rule lives
// in WHY_RULES and the math carries only its index (\htmlData{why=N}), so copy, Explain, search and kindle see plain math.
const WHY_RULES=[], WHY_IX=new Map();
function whyArgs(t,i){ // i at the char after \why: returns {name,a,b,end} or null (brace-matched)
  let name='', j=i; while(t[j]===' ')j++;
  if(t[j]==='['){ const k=t.indexOf(']',j); if(k<0)return null; name=t.slice(j+1,k); j=k+1; }
  const grp=()=>{ while(t[j]===' ')j++; if(t[j]!=='{')return null; let d=0, k=j; for(;k<t.length;k++){ if(t[k]==='\\'){k++;continue} if(t[k]==='{')d++; else if(t[k]==='}'&&--d===0)break; } if(k>=t.length)return null; const g=t.slice(j+1,k); j=k+1; return g; };
  const a=grp(); if(a===null)return null; const b=grp(); if(b===null)return null;
  return {name,a,b,end:j};
}
function whyMap(t,f){ // replace each \why{…}{…} by f(args); \whyever (a longer command name) is left alone
  let out='', i=0;
  for(;;){ const k=t.indexOf('\\why',i); if(k<0){ out+=t.slice(i); return out; }
    const g=/[A-Za-z]/.test(t[k+4]||'')?null:whyArgs(t,k+4);
    if(!g){ out+=t.slice(i,k+4); i=k+4; continue; }
    out+=t.slice(i,k)+f(g); i=g.end; } }
const stripWhy=t=>t.indexOf('\\why')<0?t:whyMap(t,g=>stripWhy(g.a));
function whyPre(t){ return t.indexOf('\\why')<0?t:whyMap(t,g=>{ const key=g.name+'\u0001'+g.b; let n=WHY_IX.get(key); if(n===undefined){ n=WHY_RULES.length; WHY_RULES.push({name:g.name.trim(),rule:g.b}); WHY_IX.set(key,n); } return `\\htmlData{why=${n}}{${whyPre(g.a)}}`; }); }
const KTRUST=c=>c.command==='\\htmlClass'||c.command==='\\htmlData';
// every formula on the board renders here: hints expanded, and the TeX annotation (what copy and Explain read) kept plain
function ktx(t,display){
  const html=katex.renderToString(whyPre(t),{displayMode:display,throwOnError:false,trust:KTRUST});
  return t.indexOf('\\why')<0?html:html.replace(/(<annotation encoding="application\/x-tex">)[\s\S]*?(<\/annotation>)/,(m,a,b)=>a+esc(stripWhy(t))+b);
}
function mathify(src){
  const slots=[];
  src=src.replace(/\$\$([\s\S]+?)\$\$/g,(m,t)=>{slots.push('<div class="mathrow" data-tex="'+encodeURIComponent(t)+'">'+ktx(marginNotes(t),true)+'</div>');return '\n@@M'+(slots.length-1)+'@@\n';});
  // inline math: $…$ on one line, no space just inside either $. "$100 and $80" is money: its would-be body "100 and " ends in a space.
  // A digit may open math ($4$, $0.5$): the closing $ must follow on the same line, which money never has.
  src=src.replace(/(^|[^\\$])\$(?!\s)([^\n$]+?)(?<!\s)\$(?!\d)/g,(m,pre,t)=>{slots.push(ktx(t,false));return pre+'@@M'+(slots.length-1)+'@@';});
  src=src.replace(/\\\$/g,'$');
  return {src,slots};
}
function unslot(html,slots){return html.replace(/<p>\s*@@M(\d+)@@\s*<\/p>/g,(m,i)=>slots[+i]).replace(/@@M(\d+)@@/g,(m,i)=>slots[+i]);}
function md(src){
  src=src.replace(/==(?=[^\s=`])([^=\n`]+?)(?<=[^\s=`])==/g,'$1'); // legacy Explain anchors (==words==) are plain text; `a == 0 || b == 0` and code spans are left alone
  const {src:s2,slots}=mathify(src);
  const html=unslot(marked.parse(s2,{mangle:false,headerIds:false}),slots);
  return html.replace(/<table>/g,'<div class="tablewrap"><table>').replace(/<\/table>/g,'</table></div>');
}
function mdInline(src){return md(src).replace(/^<p>|<\/p>\s*$/g,'');}

// split lesson body into top-level segments with source line numbers
function segments(text,baseLine){
  const lines=text.split('\n'); const out=[]; let i=0;
  while(i<lines.length){
    if(!lines[i].trim()){i++;continue}
    const start=i;
    if(/^::: /.test(lines[i])){let depth=1;i++;while(i<lines.length&&depth>0){if(/^::: /.test(lines[i]))depth++;else if(/^:::\s*$/.test(lines[i]))depth--;i++;}}
    else if(/^\$\$/.test(lines[i].trim())){ if(!/\$\$.*\$\$/.test(lines[i])){i++;while(i<lines.length&&!/\$\$/.test(lines[i]))i++;} i++; if(i<lines.length&&/^units:/.test(lines[i]))i++; }
    else if(/^```/.test(lines[i])){i++;while(i<lines.length&&!/^```/.test(lines[i]))i++;i++;}
    else {
      // a paragraph or list; a fence indented under a list item may hold blank lines, so it does not end the block
      let f=/^\s+(```|~~~)/.test(lines[i]); i++;
      while(i<lines.length&&(f||(lines[i].trim()&&!/^(#{1,6} |::: |\$\$|```)/.test(lines[i])))){ if(/^\s+(```|~~~)/.test(lines[i]))f=!f; i++; }
    }
    out.push({line:baseLine+start+1,raw:lines.slice(start,i).join('\n')});
  }
  return out;
}

function container(raw){
  const m=raw.match(/^::: (\w+)\s*(.*)$/m); const kind=m[1], arg=(m[2]||'').trim();
  const inner=raw.split('\n').slice(1,-1).join('\n');
  switch(kind){
    case 'interactive': return renderInteractive(arg,inner);
    case 'checkin':{
      // "- question || answer", one per item. An item may continue on indented lines and hold fenced code;
      // the first || outside code splits question from answer (Java's || inside code stays put)
      const items=[]; let cur=null, fence=false;
      for(const l of inner.split('\n')){
        const fl=/^\s*(```|~~~)/.test(l);
        if(!fence&&/^\s?-(\s|$)/.test(l)){ cur=[l.replace(/^\s?-\s*/,'')]; items.push(cur); }
        else if(cur&&(fence||fl||/^\s+\S/.test(l)||!l.trim())) cur.push(l.replace(/^ {1,2}/,''));
        if(fl)fence=!fence;
      }
      const qa=t=>{ const L=t.split('\n'); let f=false;
        for(let k=0;k<L.length;k++){ const l=L[k]; if(/^\s*(```|~~~)/.test(l)){f=!f;continue;} if(f)continue;
          let tick=false; for(let i=0;i<l.length-1;i++){ if(l[i]==='`')tick=!tick; else if(!tick&&l[i]==='|'&&l[i+1]==='|') return [L.slice(0,k).concat(l.slice(0,i)).join('\n'),[l.slice(i+2)].concat(L.slice(k+1)).join('\n')]; } }
        return [t,'']; };
      const blockOrInline=t=>/^\s*(```|~~~)/m.test(t)?`<div class="qblock">${md(t)}</div>`:mdInline(t);
      return '<div class="check">'+items.map(it=>{ const [q,a]=qa(it.join('\n').trim()); return `<details><summary><span class="sq">${blockOrInline(q.trim().replace(/\\displaystyle\s*/g,''))}</span></summary><div>${md(a.trim())}</div></details>`; }).join('')+'</div>';
    }
    case 'prerequisites': return `<details class="prerequisites"><summary>Prerequisites</summary><div>${md(inner)}</div></details>`;
    case 'sources': return `<details class="prerequisites sources"><summary>Sources</summary><div>${md(inner)}</div></details>`;
    case 'contents': return `<details class="prerequisites contents"><summary>Contents</summary><div>${md(inner)}</div></details>`;
    case 'numeric': return `<details><summary>numeric detail</summary><div>${md(inner)}</div></details>`;
    case 'predict':{
      const ls=inner.split('\n').filter(l=>l.trim()); const reveal=ls.find(l=>/^reveal:/.test(l));
      const raw=ls.filter(l=>!/^reveal:/.test(l)).map(l=>l.replace(/^\s*-\s*/,''));
      // a leading * marks the correct option; without one the block just commits and reveals
      let key=-1; const opts=raw.map((o,i)=>{if(/^\*\s*/.test(o)){key=i;return o.replace(/^\*\s*/,'')}return o;});
      return `<div class="predict" data-key="${key}"><div class="btns">${opts.map((o,i)=>`<button class="btn" data-choice="${i}">${mdInline(o)}</button>`).join('')}</div><details class="reveal"><summary>reveal</summary><div>${md((reveal||'').replace(/^reveal:\s*/,''))}</div></details></div>`;
    }
    case 'exp':{
      const f=arg.split(/\s+/); const id=f[0]; const folded=f.includes('folded'); expCount++;
      // first line is "**label** — body"; the label becomes a chip, the body renders like any lesson block
      let label='', body=inner; const lm=inner.match(/^\*\*([^*]+)\*\*\s*(?:—|-|:)\s*/); if(lm){label=lm[1].trim(); body=inner.slice(lm[0].length);}
      const parts=segments(body,0).map(s=>/^::: /.test(s.raw)?container(s.raw):md(s.raw)).join('');
      return `<div class="fold${folded?' closed':''}" data-for="${id}" data-label="${esc(label).toLowerCase()}"><div class="in"><div class="exp" data-id="${id}"><div class="exphead"><button type="button" class="exptoggle" aria-expanded="${!folded}" aria-controls="body-${id}"><span aria-hidden="true">💡</span><span class="explabel">${label?mdInline(label):'Explanation'}</span></button><button type="button" class="expremove" aria-label="Remove explanation">×</button></div><div class="expbody" id="body-${id}">${parts}</div></div></div></div>`;
    }
    case 'photo':{
      // ::: photo [side|wide]   lines: query: <what to fetch> | src: <assets/… or https://…> | credit: … | caption: …
      const side=/\bside\b/.test(arg); const kv={}; const rest=[];
      inner.split('\n').forEach(l=>{ const m=l.match(/^(query|src|credit|caption|alt|missing):\s*(.*)$/); if(m)kv[m[1]]=m[2].trim(); else if(l.trim())rest.push(l); });
      if(kv.missing&&!kv.src) return '';  // no licensed photo exists: better nothing than a wrong one
      const cap=kv.caption||rest.join(' ');
      const src=kv.src?(kv.src.startsWith('http')?kv.src:WSB+'/assets/'+kv.src.replace(/^assets\//,'')):'';
      const body=src?`<img src="${src}" alt="${esc(kv.alt||kv.query||'')}" loading="lazy">`:`<div class="finding">finding a photo of ${esc(kv.query||'…')}<span class="nubi"></span></div>`;
      return `<figure class="photo ${side?'side':'wide'}">${body}<figcaption>${cap?mdInline(cap):esc(shortCap(kv.credit))}</figcaption></figure>`;
    }
    case 'figure':{
      const [path,flag]=arg.split(/\s+/); const src=path.startsWith('http')||path.startsWith('/')?path:WSB+'/assets/'+path.replace(/^assets\//,'');
      const wide=flag==='wide'||/\.svg$/i.test(path);
      const body=/\.svg$/i.test(path)?`<div class="svgslot" data-src="${src}"></div>`:`<img src="${src}" alt="">`;
      return `<figure class="figure${wide?' wide':''}">${body}<figcaption>${md(inner)}</figcaption></figure>`;
    }
    case 'fig':{
      let spec; try{spec=JSON.parse(inner.trim()||'{}')}catch(e){return `<figure class="figure wide"><p class="fail">fig ${esc(arg)}: spec is not valid JSON (${esc(e.message)})</p></figure>`;}
      try{ const r=window.Fig.render(arg,spec); const cap=spec.caption?`<figcaption>${md(spec.caption)}</figcaption>`:''; const warn=r.warnings.length?`<p class="fail">${esc(r.warnings.join(' · '))}</p>`:''; return `<figure class="figure wide">${r.svg}${cap}${warn}</figure>`; }
      catch(e){return `<figure class="figure wide"><p class="fail">fig ${esc(arg)}: ${esc(e.message)}</p></figure>`;}
    }
    case 'video':{
      if(/\.(mp4|webm|mov)$/i.test(arg)){ const src=arg.startsWith('http')||arg.startsWith('/')?arg:WSB+'/assets/'+arg.replace(/^assets\//,''); return `<div><video class="video" src="${src}" controls playsinline preload="metadata"></video><p class="credit">${mdInline(inner)}</p></div>`; }
      return `<div><iframe class="video" src="${arg}" allowfullscreen title="video"></iframe><p class="credit">${mdInline(inner)}</p></div>`;}
    case 'quiz':{
      const t=(inner.match(/topics:\s*(.+)/)||[])[1]||''; const topics=t.split(',').map(s=>s.trim()).filter(Boolean);
      // Built-in items render in order (multiple choice as a numbered list). Every
      // ::: card in the quiz, wherever it sits, joins one deck shown where the first
      // card was; ::: score blocks attach to their card instead of rendering alone.
      const segs=segments(inner.replace(/topics:.*\n?/,''),0);
      const cards=[], scores={}, parts=[]; let deckAt=-1;
      segs.forEach(sg=>{
        const m=sg.raw.match(/^::: (\w+)\s*(.*)$/m);
        if(m&&m[1]==='card'){ if(deckAt<0){deckAt=parts.length;parts.push('');} cards.push(parseCard(sg.raw)); return; }
        if(m&&m[1]==='score'){ const [it,nn]=(m[2]||'').trim().split(/\s+/); if(it&&!/^\d+$/.test(it)){scores[it]={n:+nn||0,body:sg.raw.split('\n').slice(1,-1).join('\n')};return;} }
        parts.push(/^::: /.test(sg.raw)?container(sg.raw):md(sg.raw));
      });
      if(deckAt>=0)parts[deckAt]=deckHtml(cards,scores);
      const chips=[`<button class="btn topic on" data-all="1">All topics</button>`].concat(topics.map(x=>`<button class="btn topic">${esc(x)}</button>`)).join('');
      return `<div class="quiz" data-topics="${esc(topics.join('|'))}"><div class="items">${parts.join('')}</div><div class="more"><p class="morelbl">More practice</p><div class="tiles"><button class="tile on" data-mode="cards"><b>Flashcards</b><span>Say it or type it. Graded 1 to 5, then the card turns.</span></button><button class="tile" data-mode="mcq"><b>Multiple choice</b><span>Choose an answer. Checked as you click.</span></button></div><div class="chips"><span class="lbl">Topic</span>${chips}</div><div class="go"><span class="sp"></span><button class="btn primary gen">Generate 4 →</button></div><div class="genbox"></div></div></div>`;
    }
    case 'mcq':{
      // stem lines, "- option" lines and a "why:" line; fenced code in the stem keeps its lines and indentation
      const [item,key]=arg.split(/\s+/); const stemL=[], opts=[], miss=[]; let why='', fence=false;
      for(const l of inner.split('\n')){
        if(/^\s*(```|~~~)/.test(l)){ fence=!fence; stemL.push(l); continue; }
        if(fence){ stemL.push(l); continue; }
        if(!l.trim())continue;
        if(/^why:/.test(l)) why=l.replace(/^why:\s*/,'');
        else if(/^\s*-/.test(l)){ const o=l.replace(/^\s*-\s*/,''), k=o.indexOf(' || '); opts.push(k<0?o:o.slice(0,k)); miss.push(k<0?'':o.slice(k+4).trim()); }   // "- option || the mistake that gives it"
        else stemL.push(l);
      }
      const stem=stemL.join('\n'), stemBlock=/^\s*(```|~~~)/m.test(stem);
      // an option that is a whole statement of code (; or {) shows as a small preformatted box
      const optHtml=o=>{ const c=o.match(/^`([^`]+)`$/); return c&&/[;{]/.test(c[1])&&c[1].length>24?`<pre class="optcode"><code>${esc(c[1])}</code></pre>`:mdInline(o); };
      const order=opts.map((o,i)=>i).sort(()=>Math.random()-.5);
      return `<div class="mcqi" data-item="${item}" data-key="${key||''}" data-why="${esc(why)}">${stemBlock?`<div class="q qblock">${md(stem)}</div>`:`<p class="q">${mdInline(stem)}</p>`}<div class="answers${opts.some(o=>o.length>100)?' long':''}" role="radiogroup" aria-label="Answer choices">${order.map((i,pos)=>`<label style="--answer-color:${['#de807c','#7aadd4','#d9bd65','#89b58a'][pos%4]}"><input type="radio" name="${item}" value="${'abcdefgh'[i]}"${miss[i]?` data-miss="${esc(miss[i])}"`:''}><span class="answer-icon" aria-hidden="true">${['▲','◆','●','■'][pos%4]}</span><span class="answer-copy">${optHtml(opts[i])}</span></label>`).join('')}</div><div class="fb"></div><button type="button" class="mreset" hidden aria-label="Reset this question" title="Clear the answer">↺ Reset</button></div>`;
    }
    case 'score':{
      const [it,nn]=String(arg||'').split(/\s+/); const n=+nn||+it||0;
      return `<div class="score" data-item="${esc(/^\d+$/.test(it||'')?'':it)}" data-n="${n}"><p class="grade${n<=2?' low':''}"><b>Score ${n} / 5</b>${pips(n)}</p>${md(inner)}</div>`;
    }
    case 'card':{ return deckHtml([parseCard(raw)],{}); }
    case 'recall':{ return deckHtml([{id:arg||'r',q:inner.trim(),answer:'',must:[]}],{}); }
    case 'trap': return calloutHtml(inner);
    // size encodes importance: ::: big (level 1) for the one or two rules a chapter rests on, ::: key (level 2) for a
    // tool formula; everything else is level 3, the normal size. Writers never hand-size with \Large or \Huge.
    // cheat sheet: ::: sheet holds ::: group <label> cards (a 2-column grid on wide screens), formulas only
    case 'sheet': return `<div class="sheet">${segments(inner,0).map(sg=>/^::: /.test(sg.raw)?container(sg.raw):md(sg.raw)).join('')}</div>`;
    case 'group': return `<section class="sheetcard"><h4 class="sheetlbl">${mdInline(arg)}</h4>${segments(inner,0).map(sg=>/^::: /.test(sg.raw)?container(sg.raw):md(sg.raw)).join('')}</section>`;
    case 'big': case 'key': return `<div class="sz ${kind==='big'?'sz1':'sz2'}">${segments(inner,0).map(sg=>/^::: /.test(sg.raw)?container(sg.raw):md(sg.raw)).join('')}</div>`;
    case 'callout': return calloutHtml(inner);
    default: return `<div class="${kind}">${md(inner)}</div>`;
  }
}

// "On the test" callout: a grader deduction, as a contrast row (wrong form struck and muted, right form bright) plus at
// most a few words. `wrong:` / `right:` lines are optional; a plain ⚠️ line renders as the same card with just its text.
const CO_ICON='<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M8 2.2 14.6 13.6H1.4z"/><path d="M8 6.4v3.4M8 11.7v.1"/></svg>';
function calloutHtml(inner){
  const kv={}, text=[];
  inner.split('\n').forEach(l=>{ const m=l.match(/^\s*(wrong|right):\s*(.*)$/); if(m)kv[m[1]]=m[2].trim(); else if(l.trim())text.push(l.replace(/^\s*⚠️?\s*/,'')); });
  const big=t=>mdInline(t.replace(/^\$(?!\$)(?!\\displaystyle)/,'$\\displaystyle '));   // display style, so x→∞ sits under lim
  const row=(kv.wrong||kv.right)?`<div class="corow">${kv.wrong?`<span class="cowrong"><span class="comk" aria-hidden="true">✗</span><span class="sr">Wrong: </span><span class="cm">${big(kv.wrong)}</span></span>`:''}${kv.wrong&&kv.right?'<span class="coarr" aria-hidden="true">→</span>':''}${kv.right?`<span class="coright"><span class="comk" aria-hidden="true">✓</span><span class="sr">Right: </span><span class="cm">${big(kv.right)}</span></span>`:''}</div>`:'';
  const t=text.join('\n').trim();
  return `<aside class="callout" role="note" aria-label="On the test"><div class="cohead">${CO_ICON}<span>On the test</span></div>${row}${t?`<div class="cotext">${md(t)}</div>`:''}</aside>`;
}
function parseCard(raw){
  const m=raw.match(/^::: card\s*(\S*)/m); const ls=raw.split('\n').slice(1,-1);
  const must=ls.filter(l=>/^must:/.test(l.trim())).map(l=>l.trim().replace(/^must:\s*/,''));
  const answer=(ls.find(l=>/^answer:/.test(l.trim()))||'').trim().replace(/^answer:\s*/,'');
  const q=ls.filter(l=>l.trim()&&!/^(must|answer):/.test(l.trim())).join('\n').trim();
  return {id:(m&&m[1])||('c'+Math.random().toString(36).slice(2,6)),q,answer,must};
}
function pips(n){return `<span class="pips">${[1,2,3,4,5].map(i=>`<i class="${i<=n?'on':''}"></i>`).join('')}</span>`;}
function verdictHtml(n,body){
  // body is the ::: score block text: *"quote"*, rationale, Missing: …
  const ls=body.split('\n').map(l=>l.trim()).filter(Boolean);
  const said=(ls.find(l=>/^\*".*"\*$/.test(l))||'').replace(/^\*"|"\*$/g,'');
  const missing=(ls.find(l=>/^Missing:/.test(l))||'').replace(/^Missing:\s*/,'');
  const rest=ls.filter(l=>l!==`*"${said}"*`&&!/^Missing:/.test(l)).join(' ');
  return `${said?`<p class="said">“${mdInline(said)}”</p>`:''}<p class="grade${n<=2?' low':''}"><b>Score ${n} / 5</b>${pips(n)}</p>${rest?`<p>${mdInline(rest)}</p>`:''}${missing?`<p class="missing">Missing: ${mdInline(missing)}</p>`:''}`;
}
function deckHtml(cards,scores){
  const n=cards.length;
  const faces=cards.map((c,i)=>{
    const sc=scores[c.id];
    const key=c.answer?mdInline(c.answer):(c.must.length?`<ul>${c.must.map(m=>`<li>${mdInline(m)}</li>`).join('')}</ul>`:'<em>No answer key on this card.</em>');
