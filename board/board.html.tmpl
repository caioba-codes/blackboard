}
let headerDone=false, body='';
async function loadLesson(){
  const r=await fetch(`/api/lesson?id=${lessonId}&from=${offset}&hash=${hash}${WSQ}`).then(r=>r.json());
  if(r.missing){main.innerHTML='<p class="empty">No lesson yet. Ask for one in the chat.</p>';return}
  if(r.reset){main.innerHTML='';blocks=0;headerDone=false;body='';offset=0;}
  if(!r.text&&!r.reset)return;
  body+=r.text; offset=r.offset; if(r.hash)hash=r.hash; else hash=await md5(body);
  // header once front matter is complete
  if(!headerDone){const {fm,body:b,fmLines}=frontMatter(body); if(/^---\n[\s\S]*?\n---\n/.test(body)||!body.startsWith('---')){main.insertAdjacentHTML('afterbegin',header(fm,null));headerDone=true;document.title=(fm.title?fm.title+' · ':'')+'Blackboard';renderedUpto=0;bodyStart=fmLines;fmCache=fm;applyAccent(fm);} else return;}
  const {body:b}=frontMatter(body);
  const segs=segments(b,bodyStart);
  const fresh=segs.slice(renderedUpto);
  fresh.forEach((s,k)=>{ if(fmCache.title&&/^# /.test(s.raw)&&renderedUpto+k===0)return; // title already in header
    const el=renderSegment(s); main.appendChild(el); if(r.reset&&!streaming)return; animate(el);});
  renderedUpto=segs.length;
  imageCredits(b); srcFiles();
  wire(); endCard();
}
let renderedUpto=0, bodyStart=0, fmCache={};
async function md5(s){ // cheap stand-in: server sends hash on reset; between appends we recompute via subtle if available
  try{const b=await crypto.subtle.digest('SHA-1',new TextEncoder().encode(s));return 'sha1:'+Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')}catch(_){return ''}
}
// The server compares md5 of the first N bytes; since we cannot md5 client-side cheaply, we keep the server's hash after reset
// and, on append, ask again with from/hash from the last full reset. To keep it simple: after each append we re-request from 0 only when the server says reset.

// ---------- grid page ----------
function card(l,w,big){
  const base='/w/'+w.slug; const src=l.photo?(l.photo.startsWith('http')?l.photo:base+'/assets/'+l.photo.replace(/^assets\//,'')):'';
  const dots=l.scores.slice(-6).map(s=>`<span class="dot${s>=3?' p':''}"></span>`).join('');
  return `<a class="card${big?'':' mini'}" href="${base}/lessons/${l.id}" data-q="${esc((l.title+' '+l.course+' '+l.exam+' '+l.id).toLowerCase())}" data-ws="${w.slug}"><span class="nt" role="button" tabindex="0" title="Open in a new tab" aria-label="Open in a new tab"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2.5h4.5V7"/><path d="M13.5 2.5 7.5 8.5"/><path d="M12 9.5v3a1 1 0 0 1-1 1H3.5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3"/></svg></span>${src?`<img class="strip" src="${src}" alt="">`:'<div class="strip"></div>'}<div class="body"><p class="t">${esc(l.title)}</p><div class="m"><span>${l.id}${big?'':' · '+esc(w.name)} · ${l.date}</span><span class="dots">${dots}</span></div></div></a>`;
}
function grid(st){
  document.title='Lessons · Blackboard';
  const wss=st.workspaces||[]; const mine=wss.find(w=>w.slug===st.slug)||wss[0];
  const total=wss.reduce((n,w)=>n+w.count,0);
  let h=`<div class="top"><div class="eyebrow"><span>${wss.length} folder${wss.length===1?'':'s'}</span><span>${total} lesson${total===1?'':'s'}</span></div></div><h1>Lessons</h1>`;
  if(!total){h+='<p class="empty">Nothing yet. Ask for a lesson in the chat.</p>';main.innerHTML=h;return}
  h+=`<div class="hubbar"><input class="hubq" type="search" placeholder="Search everything in every lesson" autocomplete="off"><div class="chips">${wss.map(w=>`<button class="chip" data-ws="${w.slug}">${esc(w.name)}</button>`).join('')}</div></div>`;
  const all=wss.flatMap(w=>w.lessons.map(l=>({l,w}))).sort((a,b)=>b.l.mtime-a.l.mtime);
  h+=`<section class="hubsec" data-sec="recent"><h2>Recent</h2><div class="row">${all.slice(0,5).map(x=>card(x.l,x.w,false)).join('')}</div></section>`;
  if(mine) h+=`<section class="hubsec" data-sec="mine" data-ws="${mine.slug}"><h2>${esc(mine.name)}<span class="sub">this folder · ${mine.count}</span><button class="openall" data-ws="${mine.slug}" title="Open every lesson in this folder as tabs, in number order">Open all ↗</button></h2><div class="grid">${mine.lessons.slice().reverse().map(l=>card(l,mine,true)).join('')}</div></section>`;
  const others=wss.filter(w=>w!==mine);
  if(others.length) h+=`<section class="hubsec" data-sec="others"><h2>Other folders on this computer</h2>${others.map(w=>`<div class="course" data-ws="${w.slug}"><h3><a href="/w/${w.slug}/lessons">${esc(w.name)}</a><span class="sub">${w.count} lesson${w.count===1?'':'s'} · last ${w.last}</span><button class="openall" data-ws="${w.slug}" title="Open every lesson in this folder as tabs, in number order">Open all ↗</button></h3><div class="row">${w.lessons.slice().reverse().map(l=>card(l,w,false)).join('')}</div></div>`).join('')}</section>`;
  main.innerHTML=h;
  // search + course chips filter every card; empty sections hide themselves
  const q=main.querySelector('.hubq'); let chip='';
  let found=null, seq=0; const apply=()=>{ const t=q.value.trim().toLowerCase(); main.querySelectorAll('.card').forEach(c=>{ const hit=c.dataset.q.includes(t)||(found&&found.has(c.getAttribute('href'))); c.hidden=!(hit&&(!chip||c.dataset.ws===chip)); }); main.querySelectorAll('.course').forEach(c=>{ c.hidden=![...c.querySelectorAll('.card')].some(x=>!x.hidden); }); main.querySelectorAll('.hubsec').forEach(sc=>{ sc.hidden=![...sc.querySelectorAll('.card')].some(x=>!x.hidden); }); };
  q.oninput=()=>{ apply(); const t=q.value.trim(); const my=++seq; if(!t){found=null;return;} fetch('/api/search?q='+encodeURIComponent(t)+'&limit=200').then(r=>r.json()).then(r=>{ if(my!==seq)return; found=new Set(r.map(h=>h.href.split('#')[0])); apply(); }).catch(()=>{}); }; main.querySelectorAll('.chip').forEach(b=>{ b.onclick=()=>{ chip=chip===b.dataset.ws?'':b.dataset.ws; main.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x.dataset.ws===chip)); apply(); }; });
  q.focus();
}

// ---------- actions ----------
async function ask(req){
  req.lesson=lessonId; if(WS)req.ws=WS;
  const r=await fetch('/ask',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(req)}).then(r=>r.json()).catch(()=>({error:'bridge down'}));
  if(r.fallback==='paste'){toast.innerHTML=`Paste in chat: <code>${esc(r.command)}</code><button class="btn" id="copy">copy</button>`;toast.style.display='block';$('#copy').onclick=()=>{navigator.clipboard.writeText(r.command);toast.style.display='none'};setTimeout(()=>toast.style.display='none',20000);}
  else if(r.error){toast.textContent='Bridge not running. Run render.sh again.';toast.style.display='block';setTimeout(()=>toast.style.display='none',5000);}
  return r;
}
// ---------- math selection: whole visual lines, not glyph fragments ----------
// KaTeX lays an aligned block out column by column, so the native highlight is a patchwork and the
// selected text is mangled. A drag that touches a display equation selects the rows it crosses
// (drawn as bands), and Explain receives those rows as TeX.
const selBands=document.createElement('div'); selBands.id='selbands'; document.body.appendChild(selBands);
