  fxChime(FX.streak>=3?[659,784,988,1319]:[784,988,1319],.07);
  fxBurst(x,y,FX.streak>=3?40:26,1);
  fxFloat('+1 XP',x+40,y-18);
  if(FX.streak>=2)fxFloat('COMBO x'+FX.streak,x+40,y+6,'combo');
  if(cleared)setTimeout(()=>{
    fxChime([523,659,784,1047,784,1047,1319],.11);
    const b=document.createElement('div'); b.id='cleared'; b.innerHTML='QUIZ CLEARED<small>every answer verified</small>'; document.body.appendChild(b); setTimeout(()=>b.remove(),2500);
