}
// ---------- lesson page ----------
function frontMatter(text){
  const m=text.match(/^---\n([\s\S]*?)\n---\n/); const fm={}; let body=text, fmLines=0;
  if(m){m[1].split('\n').forEach(l=>{const i=l.indexOf(':');if(i>0)fm[l.slice(0,i).trim()]=l.slice(i+1).trim().replace(/^"|"$/g,'');});body=text.slice(m[0].length);fmLines=m[0].split('\n').length-1;}
  return {fm,body,fmLines};
