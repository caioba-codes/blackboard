// ---------- brainstorm ----------
// While a lesson is being researched (it has a title but no body yet), the agent posts notes with bin/brainstorm.sh:
// the page writes new lines by hand, wipes removed or moved lines with a felt eraser, and when the first real block
// lands it wipes the whole board and starts the lesson. Same pen clock, so writing and erasing never overlap.
function bsBox(){ let b=document.getElementById('brainstorm'); if(!b){ b=document.createElement('div'); b.id='brainstorm'; b.setAttribute('aria-label','Planning the lesson'); } return b; }
function bodyStarted(){ return !!main.querySelector(':scope > .blk:not(.hdr)'); }
function bsLine(t){ const d=document.createElement('div'); d.className='bl'+(/^[A-Z][^:]{0,24}:/.test(t)?' head':'')+(/^\s*[-•·]/.test(t)?' sub':''); d.dataset.t=t; d.textContent=t.replace(/^\s*[-•·]\s*/,'– '); d.style.setProperty('--tilt',((seeded(t)()-.5)*1.2).toFixed(2)+'deg'); return d; }
function eraseLine(el,box){
  const dur=Math.min(1200,Math.max(450,el.offsetWidth*1.2)), wait=penReserve(dur+90);
  el.dataset.gone='1';
  setTimeout(()=>{
    if(!el.isConnected)return;
    const x0=el.offsetLeft-44, x1=el.offsetLeft+el.offsetWidth-34, y=el.offsetTop+el.offsetHeight/2-18;
    const sm=el.cloneNode(true); sm.classList.add('smudge'); sm.style.left=el.offsetLeft+'px'; sm.style.top=el.offsetTop+'px'; box.appendChild(sm);
    const er=document.createElement('div'); er.className='eraser'; box.appendChild(er);
    const path=[0,.2,.4,.6,.8,1].map((f,i)=>({transform:`translate(${x0+(x1-x0)*f}px,${y+(i%2?-7:6)}px) rotate(${i%2?5:-5}deg)`}));
    er.animate(path,{duration:dur,easing:'ease-in-out',fill:'forwards'});
    el.animate([{clipPath:'inset(-12px 0 -12px 0)'},{clipPath:'inset(-12px 0 -12px 100%)'}],{duration:dur,easing:'ease-in-out',fill:'forwards'});
    setTimeout(()=>{ er.animate([{opacity:1},{opacity:0}],{duration:220,fill:'forwards'}).onfinish=()=>er.remove(); el.remove(); requestAnimationFrame(()=>sm.style.opacity='0'); setTimeout(()=>sm.remove(),1800); },dur);
